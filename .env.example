###> symfony/framework-bundle ###
# Environment: dev, prod, test
APP_ENV=prod

# Generate with: php bin/console secrets:generate-keys
# Or: openssl rand -hex 32
APP_SECRET=your_secret_key_here_change_me_32_chars_minimum

# Symfony Debug (set to 0 in production)
APP_DEBUG=0
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format: mysql://user:password@host:port/database_name?serverVersion=8.0
# Example: mysql://root:password@127.0.0.1:3306/infpf_db?serverVersion=8.0
DATABASE_URL="mysql://db_user:db_password@localhost:3306/db_name?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Format: doctrine://default (use database as queue)
# Or: redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Format for Gmail: gmail+smtp://username:password@default
# Format for Mailgun: mailgun+smtp://USERNAME:PASSWORD@default?region=eu
# Format for SMTP: smtp://user:pass@smtp.example.com:465
MAILER_DSN=gmail+smtp://your-email@gmail.com:your-app-password@default
###< symfony/mailer ###

###> karser/karser-recaptcha3-bundle ###
# Get your keys at: https://www.google.com/recaptcha/admin
RECAPTCHA3_KEY=your_recaptcha_site_key_here
RECAPTCHA3_SECRET=your_recaptcha_secret_key_here
###< karser/karser-recaptcha3-bundle ###

###> sentry/sentry-symfony ###
# Get your DSN at: https://sentry.io/settings/projects/
# Format: https://public_key@sentry.io/project_id
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id
###< sentry/sentry-symfony ###

###> stripe/stripe-php ###
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
###< stripe/stripe-php ###

###> Custom Application Settings ###
# Site URL (used for sitemap generation, emails, etc.)
SITE_URL=https://infpf.fr

# Admin email for notifications
ADMIN_EMAIL=admin@infpf.fr

# Enable/Disable maintenance mode
MAINTENANCE_MODE=false
###< Custom Application Settings ###
