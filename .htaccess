<IfModule mod_rewrite.c >
    RewriteEngine on
    RewriteOptions inherit

    # SSL and let's encrypt
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/.+$
    RewriteCond %{REQUEST_URI} !^/\.well-known/pki-validation/[A-F0-9]{32}\.txt(?:\ Comodo\ DCV)?$
    RewriteRule ^.well-known/acme-challenge - [L]

    # redirect to no-www
    RewriteBase /
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

    # https redirect
    RewriteCond %{HTTPS} !=on
    RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # =============================================
    # MAINTENANCE MODE - DESACTIVE
    # Pour reactiver : decommenter les 2 lignes "maintenance"
    # et commenter le bloc "redirect all requests to public directory"
    # =============================================
    # RewriteCond %{REQUEST_URI} !^/public/maintenance\.php$
    # RewriteRule ^ /public/maintenance.php [L]

    # redirect all requests to public directory
    RewriteCond %{REQUEST_URI} !public/
    RewriteRule (.*) /public/$1 [L]
</IfModule>

# =============================================
# HSTS — Strict-Transport-Security
# Force HTTPS pour 1 an (31536000s), inclut sous-domaines
# Préload : optionnel, pour soumettre à hstspreload.org
# =============================================
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # Sécurité supplémentaire : protections basiques navigateurs
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
