# ============================================
# HEADERS DE SECURITE (Standards 2026)
# ============================================
<IfModule mod_headers.c>
    # Protection contre le clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Empêche le sniffing MIME
    Header always set X-Content-Type-Options "nosniff"
    
    # Protection XSS (navigateurs anciens)
    Header always set X-XSS-Protection "1; mode=block"
    
    # Force HTTPS pendant 1 an + sous-domaines
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Contrôle des informations referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Désactive les fonctionnalités sensibles du navigateur
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    
    # Content Security Policy - DESACTIVEE temporairement (cause problemes avec jQuery, AOS)
    # A reactiver une fois les dependances locales (sans CDN externe)
    # Header always set Content-Security-Policy "..."
</IfModule>

# ============================================
# CACHE CONTROL
# ============================================
<IfModule mod_headers.c>
    # Pour les pages HTML/PHP - pas de cache
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # CSS, JS et images avec cache longue durée (1 an)
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Force la mise à jour du CDN
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Symfony front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
