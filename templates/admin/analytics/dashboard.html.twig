            <div class="chart-container">
                <canvas id="visitsChart"></canvas>
            </div>
        </div>

        <!-- Deux colonnes : Pages populaires + Sources de trafic -->
        <div class="two-column-grid">
            <!-- Pages les plus visitées -->
            <div class="dashboard-section">
                <div class="section-header">
                    <h2 class="section-title">Pages les plus visitées</h2>
                </div>
                <div id="topPagesContainer">
                    <div class="empty-state">
                        <div class="empty-state__icon">📊</div>
                        <div class="empty-state__text">Chargement...</div>
                    </div>
                </div>
            </div>
            
            <!-- Sources de trafic -->
            <div class="dashboard-section">
                <div class="section-header">
                    <h2 class="section-title">Sources de trafic</h2>
                </div>
                <div id="trafficSourcesContainer">
                    <div class="empty-state">
                        <div class="empty-state__icon">🌐</div>
                        <div class="empty-state__text">Chargement...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistiques Device / Browser -->
        <div class="two-column-grid">
            <!-- Par appareil -->
            <div class="dashboard-section">
