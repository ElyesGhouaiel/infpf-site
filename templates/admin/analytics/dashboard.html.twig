                    <div class="empty-state">
                        <div class="empty-state__icon">📱</div>
                        <div class="empty-state__text">Chargement...</div>
                    </div>
                </div>
            </div>
            
            <!-- Par navigateur -->
            <div class="dashboard-section">
                <div class="section-header">
                    <h2 class="section-title">Par navigateur</h2>
                </div>
                <div id="browserStatsContainer">
                    <div class="empty-state">
                        <div class="empty-state__icon">🌐</div>
                        <div class="empty-state__text">Chargement...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js pour les graphiques -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// État global
let currentPeriod = 'today';
let autoRefreshInterval = null;
let chartInstance = null;

// Au chargement de la page
document.addEventListener('DOMContentLoaded', function() {
    
    // Initialiser les contrôles
    initPeriodButtons();
    initAutoRefresh();
    
    // Charger les données initiales
    loadData();
});

// Initialiser les boutons de période
function initPeriodButtons() {
    const buttons = document.querySelectorAll('.period-btn');
    buttons.forEach(btn => {
        btn.addEventListener('click', function() {
            // Retirer la classe active de tous les boutons
            buttons.forEach(b => b.classList.remove('active'));
            // Ajouter la classe active au bouton cliqué
            this.classList.add('active');
            // Changer la période
            currentPeriod = this.dataset.period;
            // Recharger les données
            loadData();
        });
    });
}

// Initialiser l'auto-refresh
function initAutoRefresh() {
    const toggle = document.getElementById('autoRefreshToggle');
    
    // Démarrer l'auto-refresh au chargement
    startAutoRefresh();
    
    toggle.addEventListener('change', function() {
        if (this.checked) {
            startAutoRefresh();
        } else {
            stopAutoRefresh();
        }
    });
}

function startAutoRefresh() {
    autoRefreshInterval = setInterval(() => {
        loadData(true); // true = silent refresh
    }, 2000); // 2 secondes - temps réel
}

function stopAutoRefresh() {
    if (autoRefreshInterval) {
        clearInterval(autoRefreshInterval);
        autoRefreshInterval = null;
    }
}

// Charger les données
async function loadData(silent = false) {
    if (!silent) {
        document.getElementById('loadingOverlay').classList.add('show');
    }
    
    try {
        const response = await fetch(`/admin/analytics/data?period=${currentPeriod}`);
        const result = await response.json();
        
        if (result.success) {
            updateDashboard(result.data);
            updateLastUpdate();
        }
    } catch (error) {
    } finally {
        if (!silent) {
            document.getElementById('loadingOverlay').classList.remove('show');
        }
    }
}

// Mettre à jour le dashboard
function updateDashboard(data) {
    // Stats générales
    document.getElementById('uniqueVisitors').textContent = formatNumber(data.generalStats.uniqueVisitors);
    document.getElementById('totalVisits').textContent = formatNumber(data.generalStats.totalVisits);
    document.getElementById('avgTime').textContent = (data.generalStats.avgTimeOnPage / 60).toFixed(1) + 'm';
    document.getElementById('bounceRate').textContent = data.generalStats.bounceRate + '%';
    
    // Consentements
    document.getElementById('consentTotal').textContent = formatNumber(data.consentStats.total);
    document.getElementById('consentAnalytics').textContent = formatNumber(data.consentStats.analytics);
    document.getElementById('consentMarketing').textContent = formatNumber(data.consentStats.marketing);
    
    if (data.consentStats.total > 0) {
        const analyticsRate = ((data.consentStats.analytics / data.consentStats.total) * 100).toFixed(1);
        const marketingRate = ((data.consentStats.marketing / data.consentStats.total) * 100).toFixed(1);
        document.getElementById('consentAnalyticsRate').textContent = analyticsRate + '% d\'acceptation';
        document.getElementById('consentMarketingRate').textContent = marketingRate + '% d\'acceptation';
    }
    
    // Top pages
    updateTopPages(data.topPages);
    
    // Sources de trafic
    updateTrafficSources(data.trafficSources);
    
    // Device stats
    updateDeviceStats(data.deviceStats);
    
    // Browser stats
    updateBrowserStats(data.browserStats);
    
    // Graphique
    updateChart(data.visitsByDay);
}

function formatNumber(num) {
    return new Intl.NumberFormat('fr-FR').format(num || 0);
}

function updateLastUpdate() {
    const now = new Date();
    const timeStr = now.toLocaleTimeString('fr-FR');
    document.getElementById('lastUpdate').textContent = `Dernière maj: ${timeStr}`;
}

function updateTopPages(pages) {
    const container = document.getElementById('topPagesContainer');
    
    if (!pages || pages.length === 0) {
        container.innerHTML = '<div class="empty-state"><div class="empty-state__icon">📊</div><div class="empty-state__text">Aucune donnée</div></div>';
        return;
    }
    
    let html = '<table class="data-table"><thead><tr><th>Page</th><th>Visites</th></tr></thead><tbody>';
    pages.forEach(page => {
        html += `<tr>
            <td>
                <div class="page-title">${page.pageTitle || 'Sans titre'}</div>
                <small style="color: #64748b;">${page.pageUrl}</small>
            </td>
            <td><span class="visit-count">${page.visits}</span></td>
        </tr>`;
    });
    html += '</tbody></table>';
    container.innerHTML = html;
}

function updateTrafficSources(sources) {
    const container = document.getElementById('trafficSourcesContainer');
    
    if (!sources || sources.length === 0) {
        container.innerHTML = '<div class="empty-state"><div class="empty-state__icon">🌐</div><div class="empty-state__text">Aucune source</div></div>';
        return;
    }
    
    let html = '<ul class="traffic-source-list">';
    sources.slice(0, 10).forEach(source => {
        const name = source.referrer || 'Direct';
        html += `<li class="traffic-source-item">
            <span class="source-name">🔗 ${name}</span>
            <span class="source-count">${source.visits}</span>
        </li>`;
    });
    html += '</ul>';
    container.innerHTML = html;
}

function updateDeviceStats(devices) {
    const container = document.getElementById('deviceStatsContainer');
    
    if (!devices || devices.length === 0) {
        container.innerHTML = '<div class="empty-state"><div class="empty-state__icon">📱</div><div class="empty-state__text">Aucune donnée</div></div>';
        return;
    }
    
    const total = devices.reduce((sum, d) => sum + parseInt(d.count), 0);
    let html = '';
    
    devices.forEach(device => {
        const percentage = ((device.count / total) * 100).toFixed(1);
        const icon = device.device === 'mobile' ? '📱' : device.device === 'tablet' ? '📲' : '💻';
        html += `
            <div class="device-stat">
                <span class="device-icon">${icon}</span>
                <span class="device-name">${device.device}</span>
                <span class="device-percentage">${percentage}%</span>
            </div>
            <div class="progress-bar">
                <div class="progress-bar__fill" style="width: ${percentage}%"></div>
            </div>
        `;
    });
    
    container.innerHTML = html;
}

function updateBrowserStats(browsers) {
    const container = document.getElementById('browserStatsContainer');
    
    if (!browsers || browsers.length === 0) {
        container.innerHTML = '<div class="empty-state"><div class="empty-state__icon">🌐</div><div class="empty-state__text">Aucune donnée</div></div>';
        return;
    }
    
    const total = browsers.reduce((sum, b) => sum + parseInt(b.count), 0);
    let html = '';
    
    browsers.forEach(browser => {
        const percentage = ((browser.count / total) * 100).toFixed(1);
        html += `
            <div class="device-stat">
                <span class="device-icon">🌐</span>
                <span class="device-name">${browser.browser}</span>
                <span class="device-percentage">${percentage}%</span>
            </div>
            <div class="progress-bar">
                <div class="progress-bar__fill" style="width: ${percentage}%"></div>
            </div>
        `;
    });
    
    container.innerHTML = html;
}

function updateChart(visitsByDay) {
    const ctx = document.getElementById('visitsChart');
    
    if (!visitsByDay || visitsByDay.length === 0) {
        ctx.parentElement.innerHTML = '<div class="empty-state"><div class="empty-state__icon">📊</div><div class="empty-state__text">Aucune donnée</div></div>';
        return;
    }
    
    const labels = visitsByDay.map(d => {
        const date = new Date(d.date);
        return date.toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' });
    });
    
    const visits = visitsByDay.map(d => parseInt(d.visits) || 0);
    const uniqueVisitors = visitsByDay.map(d => parseInt(d.uniqueVisitors) || 0);
    
    // Détruire l'ancien graphique
    if (chartInstance) {
        chartInstance.destroy();
    }
    
    // Créer le nouveau graphique
    chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Visites totales',
                    data: visits,
                    borderColor: '#0b3f89',
                    backgroundColor: 'rgba(11, 63, 137, 0.1)',
                    tension: 0.4,
                    fill: true
                },
                {
                    label: 'Visiteurs uniques',
                    data: uniqueVisitors,
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    tension: 0.4,
                    fill: true
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
}
</script>
{% endblock %}
