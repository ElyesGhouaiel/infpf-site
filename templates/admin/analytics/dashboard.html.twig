{% extends 'base.html.twig' %}

{% block title %}Dashboard Analytics - INFPF{% endblock %}

{% block body %}
<style>
/* Dashboard Analytics - Design Ultra-Moderne */
.analytics-dashboard {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    min-height: 100vh;
    padding: 40px 20px;
}

.dashboard-container {
    max-width: 1400px;
    margin: 0 auto;
}

.dashboard-header {
    background: linear-gradient(135deg, #0b3f89 0%, #1e5cb8 100%);
    color: white;
    padding: 40px;
    border-radius: 16px;
    margin-bottom: 30px;
    box-shadow: 0 8px 32px rgba(11, 63, 137, 0.3);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.dashboard-header-content h1 {
    margin: 0 0 8px 0;
    font-size: 36px;
    font-weight: 700;
}

.dashboard-header-content p {
    margin: 0;
    opacity: 0.9;
    font-size: 16px;
}

/* Filtres de période + Auto-refresh */
.dashboard-controls {
    display: flex;
    align-items: center;
    gap: 16px;
}

.period-selector {
    display: flex;
    gap: 8px;
    background: rgba(255, 255, 255, 0.1);
    padding: 8px;
    border-radius: 12px;
}

.period-btn {
    padding: 10px 20px;
    background: transparent;
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
    font-size: 14px;
}

.period-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
}

.period-btn.active {
    background: white;
    color: #0b3f89;
    border-color: white;
}

.auto-refresh-toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.1);
    padding: 12px 20px;
    border-radius: 12px;
}

.auto-refresh-toggle label {
    color: white;
    font-weight: 600;
    font-size: 14px;
    margin: 0;
}

.toggle-switch {
    position: relative;
    width: 50px;
    height: 26px;
}

.toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.3);
    transition: 0.4s;
    border-radius: 26px;
}

.toggle-slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    transition: 0.4s;
    border-radius: 50%;
}

input:checked + .toggle-slider {
    background-color: #10b981;
}

input:checked + .toggle-slider:before {
    transform: translateX(24px);
}

.last-update {
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
    margin-left: 12px;
}

/* Loading overlay */
.loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}

.loading-overlay.show {
    display: flex;
}

.loading-spinner {
    width: 60px;
    height: 60px;
    border: 4px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Cartes statistiques */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.stat-card {
    background: white;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    border-left: 4px solid #0b3f89;
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
}

.stat-card__icon {
    font-size: 40px;
    margin-bottom: 12px;
}

.stat-card__label {
    font-size: 14px;
    color: #64748b;
    margin-bottom: 8px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.stat-card__value {
    font-size: 36px;
    font-weight: 700;
    color: #0b3f89;
    margin: 0;
}

.stat-card__trend {
    font-size: 14px;
    margin-top: 8px;
    color: #10b981;
    font-weight: 600;
}

.stat-card__trend.negative {
    color: #ef4444;
}

/* Section de contenu */
.dashboard-section {
    background: white;
    border-radius: 16px;
    padding: 32px;
    margin-bottom: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2px solid #e2e8f0;
}

.section-title {
    font-size: 24px;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
}

.section-subtitle {
    font-size: 14px;
    color: #64748b;
    margin-top: 4px;
}

/* Grille 2 colonnes */
.two-column-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
    gap: 24px;
}

/* Tableaux */
.data-table {
    width: 100%;
    border-collapse: collapse;
}

.data-table thead {
    background: #f8fafc;
}

.data-table th {
    text-align: left;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 600;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid #e2e8f0;
}

.data-table td {
    padding: 16px;
    border-bottom: 1px solid #f1f5f9;
    color: #1e293b;
}

.data-table tr:hover {
    background: #f8fafc;
}

.page-title {
    font-weight: 600;
    color: #0b3f89;
}

.visit-count {
    display: inline-block;
    background: #e0f2fe;
    color: #0369a1;
    padding: 4px 12px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 14px;
}

/* Graphiques (Chart.js) */
.chart-container {
    position: relative;
    height: 300px;
    margin-top: 20px;
}

/* Badge de consentement */
.consent-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 14px;
}

.consent-badge.accepted {
    background: #d1fae5;
    color: #065f46;
}

.consent-badge.rejected {
    background: #fee2e2;
    color: #991b1b;
}

/* Liste de sources */
.traffic-source-list {
    list-style: none;
    padding: 0;
    margin: 0;
}

.traffic-source-item {
    padding: 16px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.traffic-source-item:last-child {
    border-bottom: none;
}

.source-name {
    font-weight: 600;
    color: #1e293b;
}

.source-count {
    background: #0b3f89;
    color: white;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
}

/* Barres de progression */
.progress-bar {
    background: #e2e8f0;
    border-radius: 8px;
    height: 10px;
    overflow: hidden;
    margin-top: 8px;
}

.progress-bar__fill {
    background: linear-gradient(135deg, #0b3f89 0%, #1e5cb8 100%);
    height: 100%;
    transition: width 0.3s ease;
}

/* Statistiques device/browser */
.device-stat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px;
    margin-bottom: 12px;
    background: #f8fafc;
    border-radius: 8px;
}

.device-icon {
    font-size: 24px;
    margin-right: 12px;
}

.device-name {
    flex: 1;
    font-weight: 600;
    color: #1e293b;
}

.device-percentage {
    font-size: 18px;
    font-weight: 700;
    color: #0b3f89;
}

/* Empty state */
.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #64748b;
}

.empty-state__icon {
    font-size: 64px;
    margin-bottom: 16px;
    opacity: 0.3;
}

.empty-state__text {
    font-size: 18px;
    font-weight: 600;
}

/* Responsive */
@media (max-width: 768px) {
    .dashboard-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
    }
    
    .dashboard-header-content h1 {
        font-size: 28px;
    }
    
    .dashboard-controls {
        flex-direction: column;
        width: 100%;
    }
    
    .period-selector {
        width: 100%;
        flex-wrap: wrap;
    }
    
    .period-btn {
        flex: 1;
    }
    
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .two-column-grid {
        grid-template-columns: 1fr;
    }
    
    .dashboard-section {
        padding: 20px;
    }
    
    .chart-container {
        height: 250px;
    }
}
</style>

<!-- Loading overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-spinner"></div>
</div>

<div class="analytics-dashboard">
    <div class="dashboard-container">
        <!-- Header avec contrôles -->
        <div class="dashboard-header">
            <div class="dashboard-header-content">
                <h1>Dashboard Analytics</h1>
                <p>Analyse complète du trafic et des comportements utilisateurs - Conforme RGPD</p>
                <a href="{{ path('app_analytics_diagnostic') }}" style="display: inline-block; margin-top: 12px; padding: 8px 16px; background: rgba(255,255,255,0.2); color: white; text-decoration: none; border-radius: 8px; font-size: 14px; font-weight: 600; transition: all 0.3s ease;">
                    🔍 Vérifier mon exclusion
                </a>
            </div>
            
            <div class="dashboard-controls">
                <!-- Sélecteur de période -->
                <div class="period-selector">
                    <button class="period-btn active" data-period="today">Aujourd'hui</button>
                    <button class="period-btn" data-period="week">7 jours</button>
                    <button class="period-btn" data-period="month">30 jours</button>
                    <button class="period-btn" data-period="year">1 an</button>
                </div>
                
                <!-- Toggle auto-refresh -->
                <div class="auto-refresh-toggle">
                    <label class="toggle-switch">
                        <input type="checkbox" id="autoRefreshToggle" checked>
                        <span class="toggle-slider"></span>
                    </label>
                    <label for="autoRefreshToggle">Temps réel (2s)</label>
                    <span class="last-update" id="lastUpdate">Chargement...</span>
                </div>
            </div>
        </div>

        <!-- Statistiques principales -->
        <div class="stats-grid" id="statsGrid">
            <div class="stat-card">
                <div class="stat-card__icon">👥</div>
                <div class="stat-card__label">Visiteurs uniques</div>
                <div class="stat-card__value" id="uniqueVisitors">-</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-card__icon">📈</div>
                <div class="stat-card__label">Total de visites</div>
                <div class="stat-card__value" id="totalVisits">-</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-card__icon">⏱️</div>
                <div class="stat-card__label">Temps moyen</div>
                <div class="stat-card__value" id="avgTime">-</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-card__icon">🚀</div>
                <div class="stat-card__label">Taux de rebond</div>
                <div class="stat-card__value" id="bounceRate">-</div>
            </div>
        </div>

        <!-- Statistiques de consentement -->
        <div class="dashboard-section">
            <div class="section-header">
                <div>
                    <h2 class="section-title">Consentements Cookies (RGPD)</h2>
                    <p class="section-subtitle">Suivi des préférences utilisateurs</p>
                </div>
            </div>
            
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-card__label">Total consentements</div>
                    <div class="stat-card__value" id="consentTotal">-</div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__label">Cookies analytiques</div>
                    <div class="stat-card__value" id="consentAnalytics">-</div>
                    <div class="stat-card__trend" id="consentAnalyticsRate"></div>
                </div>
                <div class="stat-card">
                    <div class="stat-card__label">Cookies marketing</div>
                    <div class="stat-card__value" id="consentMarketing">-</div>
                    <div class="stat-card__trend" id="consentMarketingRate"></div>
                </div>
            </div>
        </div>

        <!-- Graphique des visites -->
        <div class="dashboard-section">
            <div class="section-header">
                <h2 class="section-title">Évolution du trafic</h2>
