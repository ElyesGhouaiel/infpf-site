{% extends 'base.html.twig' %}

{% block title %}Diagnostic Base de Données - INFPF{% endblock %}

{% block body %}
<style>
body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    padding: 40px 20px;
}

.diagnostic-container {
    max-width: 1400px;
    margin: 0 auto;
}

.card {
    background: white;
    border-radius: 20px;
    padding: 40px;
    margin-bottom: 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

h1 {
    color: #0b3f89;
    margin-bottom: 10px;
    font-size: 36px;
}

h2 {
    color: #0b3f89;
    margin-bottom: 20px;
    font-size: 24px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin: 30px 0;
}

.stat-card {
    background: #f8fafc;
    padding: 24px;
    border-radius: 12px;
    border-left: 4px solid #0b3f89;
    text-align: center;
}

.stat-label {
    font-size: 14px;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 12px;
}

.stat-value {
    font-size: 42px;
    font-weight: 700;
    color: #0b3f89;
}

.alert {
    padding: 20px;
    border-radius: 12px;
    margin: 20px 0;
    border-left: 4px solid;
}

.alert-success {
    background: #d1fae5;
    color: #065f46;
    border-color: #10b981;
}

.alert-warning {
    background: #fef3c7;
    color: #92400e;
    border-color: #f59e0b;
}

.alert-danger {
    background: #fee2e2;
    color: #991b1b;
    border-color: #ef4444;
}

.data-table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
}

.data-table thead {
    background: #f8fafc;
}

.data-table th {
    text-align: left;
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 600;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 2px solid #e2e8f0;
}

.data-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #f1f5f9;
    color: #1e293b;
    font-size: 14px;
}

.data-table tr:hover {
    background: #f8fafc;
}

.badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
}

.badge-success {
    background: #d1fae5;
    color: #065f46;
}

.badge-danger {
    background: #fee2e2;
    color: #991b1b;
}

.btn {
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
}

.btn-primary {
    background: linear-gradient(135deg, #0b3f89 0%, #1e5cb8 100%);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(11, 63, 137, 0.3);
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #64748b;
}

.empty-state__icon {
    font-size: 64px;
    margin-bottom: 16px;
    opacity: 0.3;
}
</style>

<div class="diagnostic-container">
    <div class="card">
        <h1>💾 Diagnostic Base de Données</h1>
        <p style="color: #64748b; font-size: 18px;">Vue détaillée des données stockées dans les tables analytics</p>
        
        <a href="{{ path('app_analytics_dashboard') }}" class="btn btn-primary" style="margin-top: 20px;">
            ← Retour au Dashboard
        </a>
    </div>

    <!-- Statistiques globales -->
    <div class="card">
        <h2>📊 Statistiques Globales</h2>
        
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Analytics</div>
                <div class="stat-value">{{ analyticsTotal }}</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-label">Total Consentements</div>
                <div class="stat-value">{{ consentTotal }}</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-label">Cookies Analytics</div>
                <div class="stat-value">{{ consentAnalytics }}</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-label">Cookies Marketing</div>
                <div class="stat-value">{{ consentMarketing }}</div>
            </div>
        </div>
        
        {% if adminTracked > 0 %}
        <div class="alert alert-danger">
            <strong>⚠️ ATTENTION !</strong> Il y a <strong>{{ adminTracked }}</strong> pages /admin trackées dans la base de données !
            <br>Ces pages ne devraient JAMAIS être trackées. Nettoyez vos données avec la page de diagnostic.
        </div>
        {% else %}
        <div class="alert alert-success">
            <strong>✅ Parfait !</strong> Aucune page /admin n'est trackée. Les exclusions fonctionnent correctement.
        </div>
        {% endif %}
    </div>

    <!-- Dernières visites -->
    <div class="card">
        <h2>🕐 Dernières Visites (Analytics)</h2>
        
        {% if lastVisits is empty %}
        <div class="empty-state">
            <div class="empty-state__icon">📭</div>
            <p><strong>Aucune donnée analytics</strong></p>
            <p>Naviguez sur le site (en mode non-admin) pour générer des visites.</p>
        </div>
        {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Page</th>
                    <th>IP (anonymisée)</th>
                    <th>Device</th>
                    <th>Browser</th>
                    <th>Temps</th>
                </tr>
            </thead>
            <tbody>
                {% for visit in lastVisits %}
                <tr>
                    <td>{{ visit.visitedAt|date('d/m/Y H:i') }}</td>
                    <td>
                        <strong>{{ visit.pageTitle ?? 'Sans titre' }}</strong><br>
                        <small style="color: #64748b;">{{ visit.pageUrl }}</small>
                    </td>
                    <td><code>{{ visit.ipAddress }}</code></td>
                    <td>{{ visit.device ?? '-' }}</td>
                    <td>{{ visit.browser ?? '-' }}</td>
                    <td>{{ visit.timeOnPage ? (visit.timeOnPage ~ 's') : '-' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>

    <!-- Derniers consentements -->
    <div class="card">
        <h2>🍪 Derniers Consentements Cookies</h2>
        
        {% if lastConsents is empty %}
        <div class="empty-state">
            <div class="empty-state__icon">📭</div>
            <p><strong>Aucun consentement enregistré</strong></p>
            <p>Les utilisateurs n'ont pas encore donné leur consentement.</p>
        </div>
        {% else %}
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>IP (anonymisée)</th>
                    <th>Analytics</th>
                    <th>Marketing</th>
                    <th>Consent Token</th>
                </tr>
            </thead>
            <tbody>
                {% for consent in lastConsents %}
                <tr>
                    <td>{{ consent.createdAt|date('d/m/Y H:i') }}</td>
                    <td><code>{{ consent.ipAddress }}</code></td>
                    <td>
                        {% if consent.analyticsCookies %}
                            <span class="badge badge-success">✓ Accepté</span>
                        {% else %}
                            <span class="badge badge-danger">✗ Refusé</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if consent.marketingCookies %}
                            <span class="badge badge-success">✓ Accepté</span>
                        {% else %}
                            <span class="badge badge-danger">✗ Refusé</span>
                        {% endif %}
                    </td>
                    <td><code style="font-size: 11px;">{{ consent.consentToken|slice(0, 20) }}...</code></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>

    <!-- Actions -->
    <div class="card">
        <h2>🛠️ Actions</h2>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <a href="{{ path('app_analytics_diagnostic') }}" class="btn btn-primary">
                🔍 Vérifier mon exclusion
            </a>
            <a href="{{ path('app_analytics_dashboard') }}" class="btn btn-primary">
                📊 Dashboard Analytics
            </a>
            <button onclick="location.reload()" class="btn btn-primary">
                🔄 Actualiser les données
            </button>
        </div>
    </div>
</div>
{% endblock %}

