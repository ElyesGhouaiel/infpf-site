{# Google Analytics 4 - Tracking Code #}
{# À activer après configuration dans JOUR3_GUIDE_IMPLEMENTATION.md #}

{% if app.environment == 'prod' and analytics_enabled|default(false) %}
<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_measurement_id }}"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  
  gtag('config', '{{ ga_measurement_id }}', {
    'anonymize_ip': true,
    'cookie_flags': 'SameSite=None;Secure',
    'cookie_domain': 'infpf.fr',
    'cookie_expires': 63072000, // 2 ans
  });
  
  // Événements personnalisés
  
  // 1. Formulaire de contact envoyé
  document.addEventListener('formSubmitSuccess', function(e) {
    gtag('event', 'form_submission', {
      'event_category': 'engagement',
      'event_label': 'contact_form',
      'form_name': e.detail.formName || 'contact',
      'form_location': window.location.pathname
    });
  });
  
  // 2. Clics sur boutons CTA importants
  document.querySelectorAll('[data-ga-event]').forEach(function(el) {
    el.addEventListener('click', function() {
      var eventData = this.dataset.gaEvent ? JSON.parse(this.dataset.gaEvent) : {};
      gtag('event', eventData.action || 'cta_click', {
        'event_category': eventData.category || 'engagement',
        'event_label': eventData.label || this.textContent.trim(),
        'button_name': eventData.name || this.id,
        'page_location': window.location.href
      });
    });
  });
  
  // 3. Téléchargements de fichiers
  document.querySelectorAll('a[href$=".pdf"], a[href$=".doc"], a[href$=".docx"], a[href$=".zip"]').forEach(function(el) {
    el.addEventListener('click', function() {
      var fileName = this.href.split('/').pop();
      gtag('event', 'file_download', {
        'event_category': 'engagement',
        'event_label': fileName,
        'file_name': fileName,
        'file_extension': fileName.split('.').pop()
      });
    });
  });
  
  // 4. Scroll depth (engagement)
  var scrollDepths = [25, 50, 75, 100];
  var scrollTriggered = [];
  
  window.addEventListener('scroll', function() {
    var scrollPercent = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    
    scrollDepths.forEach(function(depth) {
      if (scrollPercent >= depth && scrollTriggered.indexOf(depth) === -1) {
        scrollTriggered.push(depth);
        gtag('event', 'scroll_depth', {
          'event_category': 'engagement',
          'event_label': depth + '%',
          'scroll_depth': depth
        });
      }
    });
  });
  
  // 5. Temps passé sur la page (engagement)
  var timeOnPage = 0;
  var timeIntervals = [30, 60, 120, 300]; // secondes
  var timeTriggered = [];
  
  setInterval(function() {
    timeOnPage += 10;
    
    timeIntervals.forEach(function(interval) {
      if (timeOnPage >= interval && timeTriggered.indexOf(interval) === -1) {
        timeTriggered.push(interval);
        gtag('event', 'time_on_page', {
          'event_category': 'engagement',
          'event_label': interval + 's',
          'time_seconds': interval
        });
      }
    });
  }, 10000); // Check toutes les 10 secondes
  
  // 6. Recherche (si vous avez une fonction de recherche)
  document.querySelectorAll('form[role="search"], .search-form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      var searchInput = this.querySelector('input[type="search"], input[name="q"], input[name="search"]');
      if (searchInput && searchInput.value) {
        gtag('event', 'search', {
          'event_category': 'engagement',
          'search_term': searchInput.value
        });
      }
    });
  });
</script>
{% endif %}


