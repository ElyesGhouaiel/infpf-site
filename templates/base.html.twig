<script>
// ===== SOUS-MENUS MOBILE ULTRA-ROBUSTE - CAPTURE PHASE =====

// Fonction simple pour toggle un sous-menu
function toggleSubmenu(parentLi, submenu) {
  console.log('🔄 Toggle sous-menu:', parentLi.id);
  var isOpen = submenu.classList.contains('sub-menu--active');
  
  // Fermer TOUS les sous-menus d'abord
  document.querySelectorAll('#menu .sub-menu').forEach(function(s) {
    s.classList.remove('sub-menu--active');
    if (s.parentElement) {
      s.parentElement.classList.remove('clicked');
    }
  });
  
  // Si ce sous-menu était fermé, l'ouvrir
  if (!isOpen) {
    submenu.classList.add('sub-menu--active');
    parentLi.classList.add('clicked');
    console.log('✅ Sous-menu ouvert:', parentLi.id);
  } else {
    console.log('❌ Sous-menu fermé:', parentLi.id);
  }
}

// Fonction ULTRA-ROBUSTE pour vérifier si on est sur mobile
function isMobileDevice() {
  // Méthode 1: Largeur d'écran
  var widthCheck = window.innerWidth <= 768;
  
  // Méthode 2: Menu burger visible
  var burgerCheck = false;
  var burger = document.querySelector('.header__menu-burger');
  if (burger) {
    var burgerStyle = window.getComputedStyle(burger);
    burgerCheck = burgerStyle.display !== 'none';
  }
  
  // Méthode 3: Menu burger actif
  var activeCheck = document.querySelector('.header__menu-burger--active') !== null || 
                    document.querySelector('.header--active') !== null;
  
  // Méthode 4: User Agent (fallback)
  var uaCheck = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
  
  var result = widthCheck || burgerCheck || activeCheck || (uaCheck && window.innerWidth <= 1024);
  console.log('📱 isMobile?', result, {width: widthCheck, burger: burgerCheck, active: activeCheck, ua: uaCheck});
  return result;
}

// INSTALLER LES EVENT LISTENERS IMMÉDIATEMENT (PHASE DE CAPTURE)
function installMobileMenuHandlers() {
  console.log('🔧 Installation des gestionnaires mobile...');
  
  // Fonction générique pour gérer un menu avec sous-menu
  function handleMenuClick(e, menuId, submenuSelector) {
    if (isMobileDevice()) {
      console.log('📱 Click détecté sur menu mobile:', menuId);
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      
      var link = e.currentTarget || e.target;
      var parentLi = link.closest('li');
      
      if (!parentLi) {
        console.error('❌ Parent LI non trouvé');
        return false;
      }
      
      var submenu = parentLi.querySelector(submenuSelector);
      if (submenu) {
        toggleSubmenu(parentLi, submenu);
      } else {
        console.error('❌ Sous-menu non trouvé:', submenuSelector);
      }
      
      return false;
    }
    return true;
  }
  
  // Gérer L'École - TRIPLE PROTECTION
  var ecoleLink = document.querySelector('#menu-item-442796 > a');
  if (ecoleLink) {
    console.log('✅ Installation gestionnaire L\'École');
    
    // Protection 1: Capture phase (priorité maximale)
    ecoleLink.addEventListener('click', function(e) {
      return handleMenuClick(e, 'menu-item-442796', '.sub-menu');
    }, true);
    
    // Protection 2: Bubble phase (standard)
    ecoleLink.addEventListener('click', function(e) {
      return handleMenuClick(e, 'menu-item-442796', '.sub-menu');
    }, false);
    
    // Protection 3: TouchStart (mobile natif)
    ecoleLink.addEventListener('touchstart', function(e) {
      if (isMobileDevice()) {
        console.log('👆 TouchStart sur L\'École');
        // Marquer le lien comme "traité par touch"
        ecoleLink.dataset.touched = 'true';
      }
    }, {passive: true});
    
  } else {
    console.error('❌ Lien L\'École non trouvé');
  }
  
  // Gérer Métiers - QUADRUPLE PROTECTION (+ SPÉCIFIQUE)
  var metiersLink = document.querySelector('#menu-item-442839 > a');
  if (metiersLink) {
    console.log('✅ Installation gestionnaire Métiers (SPÉCIAL)');
    
    // Protection 1: Capture phase (ULTRA priorité)
    metiersLink.addEventListener('click', function(e) {
      if (isMobileDevice()) {
        console.log('📱🔴 CLICK MÉTIERS INTERCEPTÉ (CAPTURE)');
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        
        var parentLi = document.getElementById('menu-item-442839');
        var submenu = parentLi ? parentLi.querySelector('.sub-menu') : null;
        
        if (submenu) {
          console.log('🔄 Toggle Métiers (submenu trouvé)');
          toggleSubmenu(parentLi, submenu);
        } else {
          console.error('❌ Sous-menu Métiers introuvable');
        }
        return false;
      }
    }, true);
    
    // Protection 2: Bubble phase
    metiersLink.addEventListener('click', function(e) {
      return handleMenuClick(e, 'menu-item-442839', '.sub-menu');
    }, false);
    
    // Protection 3: TouchStart
    metiersLink.addEventListener('touchstart', function(e) {
      if (isMobileDevice()) {
        console.log('👆 TouchStart sur Métiers');
        metiersLink.dataset.touched = 'true';
      }
    }, {passive: true});
    
    // Protection 4: MouseDown (si touch échoue)
    metiersLink.addEventListener('mousedown', function(e) {
      if (isMobileDevice()) {
        console.log('🖱️ MouseDown sur Métiers (mobile)');
      }
    }, false);
    
  } else {
    console.error('❌ Lien Métiers non trouvé');
  }
  
  // Gérer Formations - TRIPLE PROTECTION
  var formationsLink = document.querySelector('#menu-item-442808 > a');
  if (formationsLink) {
    console.log('✅ Installation gestionnaire Formations');
    
    formationsLink.addEventListener('click', function(e) {
      return handleMenuClick(e, 'menu-item-442808', '.sub-menu');
    }, true);
    
    formationsLink.addEventListener('click', function(e) {
      return handleMenuClick(e, 'menu-item-442808', '.sub-menu');
    }, false);
    
    formationsLink.addEventListener('touchstart', function(e) {
      if (isMobileDevice()) {
        console.log('👆 TouchStart sur Formations');
        formationsLink.dataset.touched = 'true';
      }
    }, {passive: true});
    
  } else {
    console.error('❌ Lien Formations non trouvé');
  }
  
  // Gérer Information - TRIPLE PROTECTION
  var infoLink = document.querySelector('#menu-item-461428 > a');
  if (infoLink) {
    console.log('✅ Installation gestionnaire Information');
    
    infoLink.addEventListener('click', function(e) {
      return handleMenuClick(e, 'menu-item-461428', '.sub-menu');
    }, true);
    
    infoLink.addEventListener('click', function(e) {
      return handleMenuClick(e, 'menu-item-461428', '.sub-menu');
    }, false);
    
    infoLink.addEventListener('touchstart', function(e) {
      if (isMobileDevice()) {
        console.log('👆 TouchStart sur Information');
        infoLink.dataset.touched = 'true';
      }
    }, {passive: true});
  }
  
  console.log('✅ Tous les gestionnaires mobiles installés');
}

// INSTALLATION IMMÉDIATE - Ne pas attendre DOMContentLoaded
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', installMobileMenuHandlers);
} else {
  // DOM déjà chargé, installer immédiatement
  installMobileMenuHandlers();
}

// Réinstaller après un délai (sécurité)
setTimeout(function() {
  console.log('🔄 Réinstallation des gestionnaires (sécurité)');
  installMobileMenuHandlers();
}, 500);
</script>
