<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>403 - Accès refusé | INFPF</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1f2937;
            overflow-x: hidden;
        }

        .error-container {
            max-width: 800px;
            width: 90%;
            background: white;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            overflow: hidden;
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .error-header {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            padding: 3rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .error-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            animation: pulse 8s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.1); opacity: 0.8; }
        }

        .error-code {
            font-size: 8rem;
            font-weight: 700;
            color: white;
            line-height: 1;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }

        .error-title {
            font-size: 2rem;
            font-weight: 600;
            color: white;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 1;
        }

        .error-subtitle {
            font-size: 1.1rem;
            color: rgba(255, 255, 255, 0.9);
            position: relative;
            z-index: 1;
        }

        .error-body {
            padding: 3rem 2rem;
        }

        .error-message {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .error-message p {
            font-size: 1.1rem;
            color: #6b7280;
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 3rem;
        }

        .btn {
            padding: 1rem 2rem;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            cursor: pointer;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0b3f89 0%, #1a5bb8 100%);
            color: white;
            box-shadow: 0 4px 14px rgba(11, 63, 137, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(11, 63, 137, 0.4);
        }

        .btn-secondary {
            background: #f3f4f6;
            color: #374151;
        }

        .btn-secondary:hover {
            background: #e5e7eb;
            transform: translateY(-2px);
        }

        .contact-section {
            background: #fffbeb;
            border-radius: 16px;
            padding: 2rem;
            margin-top: 2rem;
            border: 2px solid #fef3c7;
        }

        .contact-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #92400e;
            margin-bottom: 1rem;
            text-align: center;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .form-label {
            font-size: 0.9rem;
            font-weight: 500;
            color: #374151;
        }

        .form-input,
        .form-textarea {
            padding: 0.875rem 1rem;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            font-size: 1rem;
            font-family: inherit;
            transition: all 0.2s;
            background: white;
        }

        .form-input:focus,
        .form-textarea:focus {
            outline: none;
            border-color: #f59e0b;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
        }

        .form-textarea {
            resize: vertical;
            min-height: 120px;
        }

        .form-submit {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .form-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(245, 158, 11, 0.3);
        }

        .form-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .contact-info {
            text-align: center;
            margin-top: 1.5rem;
            padding: 1.5rem;
            background: white;
            border-radius: 12px;
        }

        .contact-info p {
            color: #6b7280;
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }

        .contact-info a {
            color: #f59e0b;
            font-weight: 600;
            text-decoration: none;
            font-size: 1.1rem;
        }

        .contact-info a:hover {
            text-decoration: underline;
        }

        .footer-links {
            text-align: center;
            padding: 2rem;
            border-top: 1px solid #e5e7eb;
        }

        .footer-links a {
            color: #6b7280;
            text-decoration: none;
            margin: 0 1rem;
            font-size: 0.9rem;
            transition: color 0.2s;
        }

        .footer-links a:hover {
            color: #f59e0b;
        }

        @media (max-width: 768px) {
            .error-code {
                font-size: 5rem;
            }

            .error-title {
                font-size: 1.5rem;
            }

            .error-subtitle {
                font-size: 1rem;
            }

            .error-body {
                padding: 2rem 1.5rem;
            }

            .actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }
        }

        .icon {
            width: 20px;
            height: 20px;
        }

        .shield-icon {
            font-size: 4rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-header">
            <div class="error-code">403</div>
            <h1 class="error-title">Accès refusé</h1>
            <p class="error-subtitle">Vous n'avez pas l'autorisation d'accéder à cette ressource</p>
        </div>

        <div class="error-body">
            <div class="error-message">
                <div class="shield-icon">🔒</div>
                <p><strong>Cette page est protégée</strong></p>
                <p>Vous n'avez pas les permissions nécessaires pour accéder à cette ressource.</p>
                <p>Si vous pensez qu'il s'agit d'une erreur, contactez l'administrateur du site.</p>
            </div>

            <div class="actions">
                <a href="/" class="btn btn-primary">
                    <svg class="icon" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
                    </svg>
                    Retour à l'accueil
                </a>
                <button onclick="window.history.back()" class="btn btn-secondary">
                    <svg class="icon" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/>
                    </svg>
                    Page précédente
                </button>
            </div>

            <div class="contact-section">
                <h2 class="contact-title">🔑 Besoin d'accéder à cette ressource ?</h2>
                <p style="text-align: center; color: #6b7280; margin-bottom: 1.5rem;">
                    Si vous avez besoin d'autorisations spéciales ou pensez qu'il s'agit d'une erreur, contactez-nous :
                </p>
                <div id="formMessage" style="display: none; padding: 1rem; border-radius: 10px; margin-bottom: 1rem; text-align: center; font-weight: 500;"></div>
                <form id="errorReportForm" class="contact-form">
                    <div class="form-group">
                        <label class="form-label" for="name">Votre nom</label>
                        <input type="text" id="name" name="name" class="form-input" placeholder="Jean Dupont" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="email">Votre email</label>
                        <input type="email" id="email" name="email" class="form-input" placeholder="vous@exemple.fr" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="message">Pourquoi avez-vous besoin d'accéder à cette ressource ?</label>
                        <textarea id="message" name="message" class="form-textarea" placeholder="Expliquez votre demande d'accès..." required></textarea>
                    </div>
                    <button type="submit" id="submitBtn" class="form-submit">
                        <span id="btnText">Envoyer la demande</span>
                        <span id="btnLoader" style="display: none;">Envoi en cours...</span>
                    </button>
                </form>
                <p style="text-align: center; margin-top: 1rem; font-size: 0.875rem; color: #6b7280;">
                    Ou contactez-nous directement : <a href="mailto:elyes@xeilos.fr" style="color: #0b3f89; font-weight: 600;">elyes@xeilos.fr</a>
                </p>
            </div>
        </div>

        <div class="footer-links">
            <a href="/">Accueil</a>
            <a href="/formation">Formations</a>
            <a href="/contactez-nous">Contact</a>
            <a href="/privacy">Confidentialité</a>
        </div>
    </div>

    <script>
        document.getElementById('errorReportForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const form = this;
            const submitBtn = document.getElementById('submitBtn');
            const btnText = document.getElementById('btnText');
            const btnLoader = document.getElementById('btnLoader');
            const formMessage = document.getElementById('formMessage');
            
            // Désactiver le bouton
            submitBtn.disabled = true;
            btnText.style.display = 'none';
            btnLoader.style.display = 'inline';
            
            // Masquer les messages précédents
            formMessage.style.display = 'none';
            
            try {
                const formData = new FormData();
                formData.append('name', document.getElementById('name').value);
                formData.append('email', document.getElementById('email').value);
                formData.append('message', document.getElementById('message').value);
                formData.append('error_code', '403');
                formData.append('error_url', window.location.href);
                
                const response = await fetch('/report-error', {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Succès
                    formMessage.textContent = '✅ ' + data.message;
                    formMessage.style.background = '#d1fae5';
                    formMessage.style.color = '#065f46';
                    formMessage.style.display = 'block';
                    
                    // Réinitialiser le formulaire
                    form.reset();
                    
                    // Faire défiler vers le message
                    formMessage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } else {
                    // Erreur
                    formMessage.textContent = '❌ ' + data.message;
                    formMessage.style.background = '#fee2e2';
                    formMessage.style.color = '#991b1b';
                    formMessage.style.display = 'block';
                }
            } catch (error) {
                // Erreur réseau
                formMessage.textContent = '❌ Erreur de connexion. Veuillez réessayer ou nous contacter directement à elyes@xeilos.fr';
                formMessage.style.background = '#fee2e2';
                formMessage.style.color = '#991b1b';
                formMessage.style.display = 'block';
            } finally {
                // Réactiver le bouton
                submitBtn.disabled = false;
                btnText.style.display = 'inline';
                btnLoader.style.display = 'none';
            }
        });
    </script>
</body>
</html>


