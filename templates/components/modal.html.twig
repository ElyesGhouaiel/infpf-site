<div id="popupForm" class="popup-form">
    <div class="popup-content">
        <span class="close">&times;</span>
        <h2>Demande de documentation</h2>
        
        <form>
            <div>
                <label for="prenom">Prénom:</label>
                <input type="text" id="prenom" name="prenom" required>
            </div>
            
            <div>
                <label for="nom">Nom:</label>
                <input type="text" id="nom" name="nom" required>
            </div>
            
            <div>
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" required>
            </div>
            
            <div>
                <label for="telephone">Numéro de téléphone:</label>
                <input type="tel" id="telephone" name="telephone" required>
            </div>
            
            <div>
                <label for="formation">Formation:</label>
                <select id="formation" name="formation" required>
                    {% for formation in formations %}
                        <option value="{{ formation.id }}">{{ formation.nameFormation }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div>
                <!-- Champ vide pour maintenir l'équilibre des colonnes -->
                &nbsp;
            </div>
            
            <div>
                <label for="commentaire">Commentaire:</label>
                <textarea id="commentaire" name="commentaire" rows="4" required></textarea>
            </div>
            
            <input type="hidden" name="modal_captcha_token" id="modal_captcha_token">
            
            <div>
                <button type="submit" id="modal-submit-btn">Envoyer</button>
            </div>
        </form>
    </div>
</div>

<!-- Script reCAPTCHA v3 pour la modal (si pas déjà chargé) -->
<script>
if (!document.querySelector('script[src*="recaptcha"]')) {
    const recaptchaScript = document.createElement('script');
    recaptchaScript.src = 'https://www.google.com/recaptcha/api.js?render=6Led29srAAAAALOQ_LxAbPMeSlkbl4NdhdFkWnzq';
    recaptchaScript.async = true;
    recaptchaScript.defer = true;
    document.head.appendChild(recaptchaScript);
}

function waitForRecaptchaModal(callback) {
    if (typeof grecaptcha !== 'undefined' && grecaptcha.ready) {
        callback();
    } else {
        setTimeout(function() { waitForRecaptchaModal(callback); }, 100);
    }
}

document.addEventListener('DOMContentLoaded', function() {
    const modalForm = document.querySelector('#popupForm form');
    if (modalForm) {
        waitForRecaptchaModal(function() {
            modalForm.addEventListener('submit', function(e) {
                const captchaInput = document.getElementById('modal_captcha_token');
                if (!captchaInput.value) {
                    e.preventDefault();
                    grecaptcha.ready(function() {
                        grecaptcha.execute('6Led29srAAAAALOQ_LxAbPMeSlkbl4NdhdFkWnzq', {action: 'documentation_request'}).then(function(token) {
                            captchaInput.value = token;
                            modalForm.submit();
                        });
                    });
                }
            });
        });
    }
});
</script>