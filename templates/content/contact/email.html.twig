<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ requestTypeLabel }} - INFPF</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            line-height: 1.6;
            color: #1e293b;
            background-color: #f8fafc;
            margin: 0;
            padding: 0;
        }
        .email-container {
            max-width: 600px;
            margin: 40px auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .email-header {
            background: linear-gradient(135deg, #0b3f89 0%, #1e5cb8 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .email-header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
        }
        .email-header p {
            margin: 8px 0 0 0;
            opacity: 0.9;
            font-size: 14px;
        }
        .email-body {
            padding: 30px;
        }
        .badge {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 20px;
        }
        .badge-devis {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
        }
        .badge-renseignement {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: white;
        }
        .info-section {
            background: #f8fafc;
            border-left: 4px solid #0b3f89;
            padding: 20px;
            margin: 20px 0;
            border-radius: 8px;
        }
        .info-row {
            margin: 12px 0;
            display: flex;
            gap: 12px;
        }
        .info-label {
            font-weight: 700;
            color: #0b3f89;
            min-width: 140px;
        }
        .info-value {
            color: #374151;
        }
        .formation-highlight {
            background: linear-gradient(135deg, rgba(11, 63, 137, 0.1), rgba(30, 92, 184, 0.1));
            border: 2px solid #0b3f89;
            border-radius: 12px;
            padding: 20px;
            margin: 20px 0;
            text-align: center;
        }
        .formation-highlight h2 {
            color: #0b3f89;
            margin: 0 0 8px 0;
            font-size: 20px;
        }
        .formation-highlight p {
            color: #64748b;
            margin: 0;
            font-size: 14px;
        }
        .message-section {
            background: #fff;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        .message-section h3 {
            margin: 0 0 12px 0;
            color: #0b3f89;
            font-size: 16px;
        }
        .message-content {
            color: #374151;
            line-height: 1.8;
            white-space: pre-wrap;
        }
        .email-footer {
            background: #f8fafc;
            padding: 20px 30px;
            text-align: center;
            color: #64748b;
            font-size: 12px;
            border-top: 1px solid #e5e7eb;
        }
        .cta-section {
            text-align: center;
            padding: 20px 0;
        }
        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            color: white;
            padding: 14px 28px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 16px;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
        }
    </style>
</head>
<body>
    <div class="email-container">
        <div class="email-header">
            <h1>{{ requestTypeLabel }}</h1>
            <p>Nouvelle demande depuis le site INFPF</p>
        </div>
        
        <div class="email-body">
            <span class="badge badge-{{ requestType }}">
                {% if requestType == 'devis' %}
                    🎯 DEMANDE DE DEVIS
                {% else %}
                    💬 DEMANDE DE RENSEIGNEMENTS
                {% endif %}
            </span>

            {% if formation %}
            <div class="formation-highlight">
                <h2>{{ formation.nameFormation }}</h2>
                <p>Formation concernée par la demande</p>
            </div>
            {% endif %}

            <div class="info-section">
                <div class="info-row">
                    <span class="info-label">👤 Nom :</span>
                    <span class="info-value">{{ name }}</span>
                </div>
                <div class="info-row">
                    <span class="info-label">📧 Email :</span>
                    <span class="info-value"><a href="mailto:{{ email }}" style="color: #0b3f89; text-decoration: none;">{{ email }}</a></span>
                </div>
                <div class="info-row">
                    <span class="info-label">📞 Téléphone :</span>
                    <span class="info-value"><a href="tel:{{ phone }}" style="color: #0b3f89; text-decoration: none;">{{ phone }}</a></span>
                </div>
            </div>

            {% if content %}
            <div class="message-section">
                <h3>💬 Message :</h3>
                <div class="message-content">{{ content }}</div>
            </div>
            {% endif %}

            <div class="cta-section">
                <a href="mailto:{{ email }}?subject=RE: {{ requestTypeLabel }} - INFPF" class="cta-button">
                    ✉️ Répondre maintenant
                </a>
            </div>
        </div>

        <div class="email-footer">
            <p><strong>Institut National de la Formation Professionnelle Française</strong></p>
            <p>257 Avenue Saint-Exupéry, 06700 Saint-Laurent-du-Var</p>
            <p>📞 04 89 05 03 55 | 📧 contact@infpf.fr</p>
        </div>
    </div>
</body>
</html>
