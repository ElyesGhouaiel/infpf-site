{% extends 'base.html.twig' %}

{% block title %}Contactez l'Institut National de Formation Professionnelle Française{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="../css/contact.min.css" rel="stylesheet"/>
{% endblock %}

{% block body %}
<!-- Hero Section - Gardée intacte selon demande -->
<div class="contact-hero">
    <div class="hero-content">
        <h1 class="hero-title">Accélérez votre carrière</h1>
        <p class="hero-subtitle">
            Obtenez une réponse personnalisée sous 24h et transformez votre projet professionnel en réussite
        </p>
    </div>
</div>

<!-- Flash Messages -->
<div class="flash-messages">
    {% for message in app.flashes('success') %}
        <div class="flash-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="flash-error">{{ message }}</div>
    {% endfor %}
</div>

<!-- Container Principal -->
<div class="contact-container">
    <!-- Section Informations de Contact - MAINTENANT EN PREMIER -->
    <div class="contact-info-section">
        <div class="contact-info-card">
            <div class="contact-info-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" width="30" height="30">
                    <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                </svg>
            </div>
            <h3 class="contact-info-title">Téléphone</h3>
            <p class="contact-info-text">04 89 05 03 55<br>Du lundi au vendredi<br>9h - 18h</p>
        </div>
        
        <div class="contact-info-card">
            <div class="contact-info-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" width="30" height="30">
                    <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                </svg>
            </div>
            <h3 class="contact-info-title">Email</h3>
            <p class="contact-info-text">contact@infpf.fr<br></p>
        </div>
        
        <div class="contact-info-card">
            <div class="contact-info-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" width="30" height="30">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
            </div>
            <h3 class="contact-info-title">Adresse</h3>
            <p class="contact-info-text">257 Avenue Saint-Exupéry<br>06700 Saint-Laurent-du-Var<br>Côte d'Azur</p>
        </div>
    </div>

    <!-- Section Formulaire Principal - MAINTENANT EN SECOND -->
    <div class="contact-content">
        <div class="contact-form-section" id="formulaire-contact">
            <div class="form-header">
                <h2 class="form-title">Parlons de votre projet de formation</h2>
                <p class="form-subtitle">Remplissez le formulaire et recevez une réponse personnalisée sous 24h</p>
                
            </div>
            
            {{ form_start(contactForm, {'attr': {'novalidate': 'novalidate', 'id': 'contact-form', 'data-turbo': 'false'}}) }}
            <div class="form-grid">
            <div class="form-group">
                <label for="{{ contactForm.name.vars.id }}">
                    Nom complet <span class="required">*</span>
                </label>
                {{ form_widget(contactForm.name, {'attr': {'placeholder': 'Prénom et nom', 'required': true}}) }}
            </div>
            
            <div class="form-group">
                <label for="{{ contactForm.email.vars.id }}">
                    Email <span class="required">*</span>
                </label>
                {{ form_widget(contactForm.email, {'attr': {'placeholder': 'votre.email@exemple.com', 'required': true}}) }}
            </div>
            
            <div class="form-group">
                <label for="{{ contactForm.numero.vars.id }}">
                    Téléphone <span class="required">*</span>
                </label>
                {{ form_widget(contactForm.numero, {'attr': {'placeholder': '06 12 34 56 78', 'required': true}}) }}
            </div>
                
            <div class="form-group full-width">
                <label for="{{ contactForm.formationId.vars.id }}">
                    Formation concernée
                </label>
                {{ form_widget(contactForm.formationId) }}
            </div>
            
            <div class="form-group full-width">
                <label for="{{ contactForm.requestType.vars.id }}">
                    Objet de votre demande <span class="required">*</span>
                </label>
                {{ form_widget(contactForm.requestType) }}
            </div>
            
            <div class="form-group full-width">
                <label for="{{ contactForm.preferredMode.vars.id }}">
                    Mode de formation souhaité
                </label>
                {{ form_widget(contactForm.preferredMode) }}
            </div>
            
            <div class="form-group full-width">
                <label for="{{ contactForm.content.vars.id }}">
                    Détails supplémentaires
                </label>
                {{ form_widget(contactForm.content, {'attr': {'placeholder': 'Parlez-nous de votre projet professionnel, vos objectifs, vos questions...', 'rows': 5}}) }}
            </div>
            </div>
            
            <div class="submit-section">
                <button type="submit" class="submit-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
                    </svg>
                    Obtenir mon plan personnalisé
                </button>
            </div>
            {{ form_rest(contactForm) }}
            {{ form_end(contactForm) }}
            
            <!-- Script pour désactiver Turbo sur le formulaire -->
            <script>
            // Désactiver Turbo globalement pour cette page
            if (window.Turbo) {
                window.Turbo.session.drive = false;
            }
            
            // Scroll automatique vers le formulaire si l'ancre #formulaire-contact est présente
            document.addEventListener('DOMContentLoaded', function() {
                if (window.location.hash === '#formulaire-contact') {
                    const formulaire = document.getElementById('formulaire-contact');
                    if (formulaire) {
                        // Attendre un court instant pour que la page soit complètement chargée
                        setTimeout(function() {
                            formulaire.scrollIntoView({ 
                                behavior: 'smooth', 
                                block: 'start'
                            });
                            // Ajouter un petit offset pour ne pas coller le formulaire en haut
                            window.scrollBy(0, -100);
                        }, 300);
                    }
                }
            });
            </script>
            
            <!-- ===== reCAPTCHA LAZY LOADING - Chargé SEULEMENT au submit (optimal) ===== -->
            <script>
            (function() {
                let recaptchaLoaded = false;
                const RECAPTCHA_SITE_KEY = '6Led29srAAAAALOQ_LxAbPMeSlkbl4NdhdFkWnzq';
                
                function loadRecaptcha() {
                    if (recaptchaLoaded) return;
                    recaptchaLoaded = true;
                    
                    const script = document.createElement('script');
                    script.src = `https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`;
                    script.async = true;
                    script.defer = true;
                    document.head.appendChild(script);
                    
                    console.log('✅ reCAPTCHA chargé au submit');
                }
                
                // Fonction pour attendre que grecaptcha soit chargé
                function waitForRecaptcha(callback) {
                    if (typeof grecaptcha !== 'undefined' && grecaptcha.ready) {
                        callback();
                    } else {
                        setTimeout(function() {
                            waitForRecaptcha(callback);
                        }, 100);
                    }
                }
            
            // Configuration du formulaire après chargement du DOM
            document.addEventListener('DOMContentLoaded', function() {
                const form = document.getElementById('contact-form');
                if (!form) {
                    return;
                }
                
                // Attendre que reCAPTCHA soit chargé
                waitForRecaptcha(function() {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        
                        grecaptcha.ready(function() {
                            grecaptcha.execute('6Led29srAAAAALOQ_LxAbPMeSlkbl4NdhdFkWnzq', {action: 'contact_form'}).then(function(token) {
                                // Ajouter le token au formulaire
                                let captchaInput = form.querySelector('input[name="contact_form[captcha]"]');
                                if (!captchaInput) {
                                    // Créer le champ s'il n'existe pas
                                    captchaInput = document.createElement('input');
                                    captchaInput.type = 'hidden';
                                    captchaInput.name = 'contact_form[captcha]';
                                    form.appendChild(captchaInput);
                                }
                                captchaInput.value = token;
                                
                                // Soumettre le formulaire
                                form.submit();
                            });
                        });
                    });
                });
            });
            </script>
        </div>
    </div>

    <!-- Section Calendly avec iframe intégrée - LAYOUT 2 COLONNES DESKTOP -->
    <div class="calendly-section">
        <div class="calendly-content">
            <!-- Texte à gauche sur desktop -->
            <div class="calendly-text-wrapper">
            <h3>Ou prenez rendez-vous directement</h3>
            <p>Choisissez votre créneau et échangez gratuitement avec nos conseillers pédagogiques</p>
            </div>
            <!-- Calendly à droite sur desktop -->
            <div class="calendly-iframe-wrapper">
            {% include 'components/calendly_iframe.html.twig' with {
                'height': '700px',
                'title': 'Je réserve mon appel gratuit - Contact INFPF'
            } %}
            </div>
        </div>
    </div>

    <!-- Section Map -->
    <div class="map-full-section">
        <div class="map-header">
            <h3 class="map-title">Notre localisation</h3>
            <p class="map-subtitle">Venez nous rencontrer au cœur de la Côte d'Azur</p>
        </div>
        <div class="map-container">
        <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2886.0385500261586!2d7.182744376855092!3d43.66816807110144!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12cdd16489388b83%3A0x5f9bd1b30eb8340a!2s257%20Av.%20Saint-Exup%C3%A9ry%2C%2006700%20Saint-Laurent-du-Var!5e0!3m2!1sfr!2sfr!4v1715769457806!5m2!1sfr!2sfr" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Localisation INFPF - 257 Avenue Saint-Exupéry, Saint-Laurent-du-Var">
        </iframe>
    </div>
</div>
</div>

<!-- Calendly maintenant intégré via iframe - Plus besoin de JavaScript popup -->



{% include 'footer.html.twig' %}

{% endblock %}
