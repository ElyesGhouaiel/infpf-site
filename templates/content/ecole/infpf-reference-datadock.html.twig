{% block body %}
<!-- Hero Section -->
<section class="datadock-hero">
	<div class="datadock-hero-content">
		<h1 class="datadock-hero-title">L'INFPF référencé DataDock</h1>
		<p class="datadock-hero-subtitle">
			Un gage de qualité et de conformité pour votre formation professionnelle
		</p>
		<div class="datadock-hero-badge">
			Référencé sous le n° 0008886
		</div>
	</div>
</section>

<!-- Main Content -->
<main class="datadock-main-container">
	<a href="{{ path('app_ecole_index') }}" class="back-hub-btn">
		Retour à L'École
	</a>

	<!-- Introduction Section -->
	<section class="datadock-section">
		<div class="datadock-intro-card">
			<div class="datadock-intro-content">
				<h2>DataDock, qu'est-ce que c'est ?</h2>
				<p>
					La plateforme <strong>DataDock</strong> est une base de données unique créée pour faciliter 
					<strong>le référencement des organismes de formation</strong>. Cet « entrepôt de données » 
					permet aux financeurs de la formation professionnelle de contrôler la conformité des organismes 
					selon <strong>6 critères de qualité</strong> définis par la Loi.
				</p>
				<p>
					Ce référencement garantit aux apprenants et aux entreprises que l'organisme de formation 
					répond aux exigences légales en matière de qualité pédagogique.
				</p>
			</div>
			<div class="datadock-intro-image">
				<img src="{{ asset('img/ico_datadocke-transparent.png') }}" alt="Logo DataDock" width="200">
			</div>
		</div>

		<!-- Objectifs -->
		<div class="datadock-objectives">
			<h3>Les objectifs des critères qualité</h3>
			<ul class="datadock-objectives-list">
				<li>Améliorer la lisibilité de l'offre de formation</li>
				<li>Inviter les prestataires à fournir un maximum d'informations</li>
				<li>Adapter l'offre de formation aux besoins du public</li>
			</ul>
		</div>
	</section>

	<!-- Critères Section -->
	<section class="datadock-section">
		<div class="datadock-section-header">
			<h2 class="datadock-section-title">Les 6 critères qualité DataDock</h2>
			<p class="datadock-section-subtitle">
				Ces critères ont été définis par la Loi pour garantir la qualité des formations
			</p>
		</div>

		<div class="datadock-criteria-grid">
			<div class="datadock-criteria-card">
				<span class="datadock-criteria-number">1</span>
				<h3>Identification des objectifs de la formation et adaptation au public formé</h3>
			</div>
			<div class="datadock-criteria-card">
				<span class="datadock-criteria-number">2</span>
				<h3>Adaptation des dispositifs d'accueil, de suivi pédagogique et d'évaluation</h3>
			</div>
			<div class="datadock-criteria-card">
				<span class="datadock-criteria-number">3</span>
				<h3>Adéquation des moyens pédagogiques, techniques et d'encadrement</h3>
			</div>
			<div class="datadock-criteria-card">
				<span class="datadock-criteria-number">4</span>
				<h3>Qualification professionnelle et formation continue du personnel formateur</h3>
			</div>
			<div class="datadock-criteria-card">
				<span class="datadock-criteria-number">5</span>
				<h3>Information du public sur l'offre, les délais d'accès et les résultats</h3>
			</div>
			<div class="datadock-criteria-card">
				<span class="datadock-criteria-number">6</span>
				<h3>Prise en compte des appréciations rendues par les stagiaires</h3>
			</div>
		</div>
	</section>

	<!-- Certification INFPF -->
	<section class="datadock-section">
		<div class="datadock-certification">
			<div class="datadock-certification-content">
				<h2>L'INFPF est référencé sur DataDock</h2>
				<p>
					Par la qualité de son offre de formation, l'<strong>Institut National de la Formation 
					Professionnelle Française</strong> est référencé sur DataDock sous le numéro 
					<strong>0008886</strong> depuis mars 2017.
				</p>
				<p>
					Ce référencement est un <strong>gage de crédibilité et de qualité supplémentaire</strong>, 
					tant pour les élèves que pour les entreprises. Cette accréditation a un impact direct sur 
					le <a href="{{ path('redirectToFinancerMaFormation') }}" style="color: white; text-decoration: underline;">financement des formations</a>.
				</p>
				<div class="datadock-badge">
					N° DataDock : 0008886
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="datadock-cta-section">
		<h3>Découvrez nos formations certifiées</h3>
		<p>Profitez de formations de qualité, éligibles aux financements grâce à notre référencement DataDock</p>
		<a href="{{ path('app_home') }}" class="datadock-modern-button">
			Voir nos formations
		</a>
	</section>
</main>
{% endblock %}
