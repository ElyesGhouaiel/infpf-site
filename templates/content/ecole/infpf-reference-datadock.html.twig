		text-align: center !important;
	}

	.datadock-modern-button {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: var(--primary-gradient);
		color: white;
		padding: 18px 40px;
		border-radius: 50px;
		text-decoration: none;
		font-weight: 600;
		font-size: 1.2rem;
		transition: var(--transition);
		box-shadow: 0 4px 15px rgba(11, 63, 137, 0.3);
	}

	.datadock-modern-button:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 25px rgba(11, 63, 137, 0.4);
		color: white;
	}

	/* ===== BACK BUTTON ===== */
	.back-hub-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--primary-color);
		text-decoration: none;
		font-weight: 600;
		padding: 12px 24px;
		border-radius: 50px;
		background: white;
		box-shadow: var(--shadow-light);
		transition: var(--transition);
		margin-bottom: 30px;
		font-size: 1.1rem;
	}

	.back-hub-btn:hover {
		background: var(--primary-color);
		color: white;
		transform: translateX(-5px);
	}

	/* ===== RESPONSIVE ===== */
	@media (max-width: 992px) {
		.datadock-intro-card {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.datadock-intro-image {
			order: -1;
		}

		.datadock-hero {
			padding: 80px 20px 40px;
		}

		.datadock-main-container {
			padding: 50px 20px;
		}

		.datadock-certification {
			padding: 40px 25px;
		}
	}

	@media (max-width: 768px) {
		.datadock-intro-card {
			padding: 30px;
		}

		.datadock-criteria-grid {
			grid-template-columns: 1fr;
		}

		.datadock-objectives {
			padding: 30px 20px;
		}
	}
</style>
