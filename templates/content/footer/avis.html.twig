{% extends 'base.html.twig' %}
{% block title %}Avis et témoignages - INFPF
{% endblock %}
{% block stylesheets %}
	<style>
		/* ===== VARIABLES CSS ===== */
		:root {
			--primary-color: #0b3f89;
			--primary-light: #1e5cb8;
			--accent-color: #00b4d8;
			--text-dark: #2d3748;
			--text-light: #718096;
			--bg-light: #f8fafc;
			--shadow-light: 0 4px 20px rgba(11, 63, 137, 0.1);
			--shadow-medium: 0 8px 30px rgba(11, 63, 137, 0.15);
			--border-radius: 16px;
			--transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		}

		/* ===== HERO SECTION MODERNE ===== */
		.avis-hero {
			background: linear-gradient(135deg, #0b3f89 0%, #1e5cb8 50%, #00b4d8 100%);
			padding: 120px 40px 60px 40px;
			text-align: center;
			color: white;
			margin-top: 0;
			position: relative;
			overflow: hidden;
		}

		.avis-hero::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
			z-index: 1;
		}

		.avis-hero-content {
			position: relative;
			z-index: 2;
			max-width: 900px;
			margin: 0 auto;
		}

		#titlePage {
			font-size: clamp(2.5rem, 6vw, 4rem);
			font-weight: 800;
			margin: 0 0 20px 0;
			text-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
			letter-spacing: -0.02em;
		}

		#descPage {
			font-size: clamp(1.2rem, 3vw, 1.8rem);
			font-weight: 400;
			margin: 0;
			opacity: 0.95;
			line-height: 1.4;
		}

		/* ===== CONTAINER REVIEWS ===== */
		.container_review {
			max-width: 1200px;
			margin: 0 auto;
			padding: 80px 40px;
        	display: grid;
			grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        	gap: 40px;
		}

		/* ===== CARDS REVIEWS ===== */
		.card_review {
			background: white;
			padding: 32px;
			border-radius: var(--border-radius);
			box-shadow: var(--shadow-light);
			border: 1px solid rgba(11, 63, 137, 0.1);
			position: relative;
			overflow: hidden;
		}

		.card_review::before {
			content: '"';
			position: absolute;
			top: -10px;
			left: 20px;
			font-size: 120px;
			color: rgba(11, 63, 137, 0.05);
			font-family: Georgia, serif;
			line-height: 1;
			z-index: 0;
		}

		/* Hover désactivé - élément non-cliquable */

		.card_review > * {
			position: relative;
			z-index: 1;
        }

        .reviewer {
			font-size: 1.4rem;
			font-weight: 700;
			color: var(--primary-color);
			margin: 0 0 8px 0;
        }

        .formation_review {
			font-size: 0.95rem;
        	font-weight: 500;
			color: var(--text-light);
			margin: 0 0 20px 0;
			text-transform: uppercase;
			letter-spacing: 0.5px;
        }

        .title_review {
			font-size: 1.5rem;
			font-weight: 700;
			color: var(--text-dark);
			margin: 0 0 16px 0;
			line-height: 1.3;
		}

		.content_review {
			font-size: 1.25rem;
			line-height: 1.7;
			color: var(--text-dark);
			margin: 0 0 20px 0;
			padding: 16px;
			background: var(--bg-light);
			border-radius: 12px;
			border-left: 3px solid var(--accent-color);
			font-weight: 600;
		}

		.score_review {
			font-size: 1.2rem;
        	font-weight: 700;
			color: var(--accent-color);
			margin: 0;
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.score_review::before {
			content: '⭐';
			font-size: 1.3rem;
		}

		/* ===== RESPONSIVE MOBILE ===== */
		@media (max-width: 768px) {
			.avis-hero {
				padding: 100px 20px 40px 20px;
			}

			#titlePage {
				font-size: clamp(2rem, 8vw, 3rem);
				margin-bottom: 16px;
			}

			#descPage {
				font-size: clamp(1.1rem, 4vw, 1.4rem);
			}

			.container_review {
				grid-template-columns: 1fr;
				padding: 60px 20px;
				gap: 30px;
			}

			.card_review {
				padding: 24px;
			}

			.reviewer {
				font-size: 1.3rem;
			}

			.formation_review {
				font-size: 0.9rem;
				margin-bottom: 16px;
			}

			.title_review {
				font-size: 1.3rem;
				margin-bottom: 12px;
			}

			.content_review {
				font-size: 1.15rem;
				padding: 14px;
				margin-bottom: 16px;
				font-weight: 600;
        }

        .score_review {
				font-size: 1.1rem;
			}
		}

		@media (max-width: 480px) {
			.avis-hero {
				padding: 80px 16px 30px 16px;
			}

			#titlePage {
				font-size: clamp(1.8rem, 8vw, 2.5rem);
			}

			#descPage {
				font-size: clamp(1rem, 4vw, 1.2rem);
			}

			.container_review {
				padding: 40px 16px;
				gap: 24px;
			}

			.card_review {
				padding: 20px;
			}

			.card_review::before {
				font-size: 80px;
				top: -5px;
				left: 15px;
			}

			.reviewer {
				font-size: 1.2rem;
			}

			.formation_review {
				font-size: 0.85rem;
			}

			.title_review {
				font-size: 1.2rem;
        }

        .content_review {
				font-size: 1.1rem;
				padding: 12px;
				font-weight: 600;
			}
        }
	</style>
{% endblock %}
{% block body %}
    <!-- Hero Section -->
    <section class="avis-hero">
        <div class="avis-hero-content">
            <h1 id="titlePage">Vos témoignages, notre fierté.</h1>
            <p id="descPage">Découvrez ce que pensent nos apprenants de leur expérience à l'INFPF.</p>
        </div>
    </section>

    <!-- Container Reviews -->
    <section id="container_review" class="container_review"> 
        <div class="card_review">
    <h3 class="reviewer">Sophie D.</h3>
    <h4 class="formation_review">Formation gestion de portefeuille financier initiation</h4>
    <h3 class="title_review">Une bonne introduction aux marchés</h3>
    <p class="content_review">Très bon équilibre entre théorie et pratique. Idéal pour ceux qui débutent dans la finance. Le formateur prend le temps de vulgariser les concepts.</p>
    <h3 class="score_review">Note : 4/5</h3>
</div>

<div class="card_review">
    <h3 class="reviewer">Yanis R.</h3>
    <h4 class="formation_review">Formation Bourse & Trading Expert - Distanciel</h4>
    <h3 class="title_review">Très complète et motivante</h3>
    <p class="content_review">Excellente formation, claire et bien rythmée. Les supports sont riches, et les exercices très pertinents. J'ai progressé rapidement.</p>
    <h3 class="score_review">Note : 5/5</h3>
</div>

<div class="card_review">
    <h3 class="reviewer">Claire L.</h3>
    <h4 class="formation_review">Formation Bourse & Trading Expert - Présentiel</h4>
    <h3 class="title_review">Une expérience enrichissante</h3>
    <p class="content_review">L'encadrement sur place est top. On est très bien accompagné et les cas pratiques sont nombreux. Un vrai plus par rapport au distanciel.</p>
    <h3 class="score_review">Note : 5/5</h3>
</div>

<div class="card_review">
    <h3 class="reviewer">Thomas B.</h3>
    <h4 class="formation_review">Formation Word</h4>
    <h3 class="title_review">Simple, clair et efficace</h3>
    <p class="content_review">Formation parfaite pour maîtriser les fonctions avancées de Word. Formateur à l'écoute et très pédagogue. Je recommande.</p>
    <h3 class="score_review">Note : 4/5</h3>
</div>

<div class="card_review">
    <h3 class="reviewer">Fatima E.</h3>
    <h4 class="formation_review">Formation Excel</h4>
    <h3 class="title_review">Une montée en compétence assurée</h3>
    <p class="content_review">J’ai appris à faire des tableaux croisés et des macros ! Très pratique pour le travail, merci au formateur très clair.</p>
    <h3 class="score_review">Note : 5/5</h3>
</div>

<div class="card_review">
    <h3 class="reviewer">Lucas M.</h3>
    <h4 class="formation_review">Formation Word Press</h4>
    <h3 class="title_review">Formation dynamique et accessible</h3>
    <p class="content_review">Une bonne initiation à WordPress. J'ai même pu créer mon propre site en fin de parcours. Super accompagnement technique.</p>
    <h3 class="score_review">Note : 4/5</h3>
</div>

<div class="card_review">
    <h3 class="reviewer">Naïma K.</h3>
    <h4 class="formation_review">Concepteur développeur d’applications - Distanciel</h4>
    <h3 class="title_review">Formation technique et bien structurée</h3>
    <p class="content_review">Beaucoup de contenu, mais très progressif. Les projets de fin de module permettent de bien s’approprier les compétences. Bravo à l’équipe !</p>
    <h3 class="score_review">Note : 5/5</h3>
</div>

<div class="card_review">
    <h3 class="reviewer">Jean-Michel D.</h3>
    <h4 class="formation_review">Formation Photoshop</h4>
    <h3 class="title_review">Créative et très pratique</h3>
    <p class="content_review">Excellent formateur ! J’ai découvert de nombreuses astuces pro. Une vraie valeur ajoutée pour mon métier de graphiste.</p>
    <h3 class="score_review">Note : 5/5</h3>
</div>

<div class="card_review">
    <h3 class="reviewer">Morgane F.</h3>
    <h4 class="formation_review">Management d'Équipe</h4>
    <h3 class="title_review">Formation utile et concrète</h3>
    <p class="content_review">Mise en situation, cas concrets, outils efficaces : parfait pour toute personne qui manage au quotidien. Très bonne énergie de groupe.</p>
    <h3 class="score_review">Note : 4/5</h3>
</div>

<div class="card_review">
    <h3 class="reviewer">David S.</h3>
    <h4 class="formation_review">Gestion du stress, confiance en soi, efficacité professionnelle</h4>
    <h3 class="title_review">Un vrai déclic personnel</h3>
    <p class="content_review">Contenu transformateur. Techniques de respiration, gestion du temps, communication : tout est utile. Très bon formateur, très humain.</p>
    <h3 class="score_review">Note : 5/5</h3>
</div>

    </section>
{% endblock %}
