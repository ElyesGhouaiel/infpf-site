{% extends 'base.html.twig' %}

{% block title %}Mentions Légales - INFPF{% endblock %}

{% block stylesheets %}
	<style>
/* ===== DESIGN MODERNE MENTIONS LÉGALES ===== */
.legal-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 60px 20px;
    line-height: 1.8;
    background: #f8f9fa;
}

.legal-header {
    text-align: center;
    margin-bottom: 60px;
    background: linear-gradient(135deg, #0b3f89 0%, #1e5cb8 100%);
    color: white;
    padding: 60px 40px;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(11, 63, 137, 0.2);
}

.legal-header h1 {
    font-size: 48px;
    margin: 0 0 16px 0;
    font-weight: 700;
}

.legal-header .subtitle {
    font-size: 18px;
    opacity: 0.95;
			margin: 0;
}

.legal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 48px;
}

.legal-card {
    background: white;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    border-left: 4px solid #0b3f89;
}

.legal-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(11, 63, 137, 0.15);
}

.legal-card__icon {
    font-size: 48px;
    margin-bottom: 20px;
    display: block;
}

.legal-card__title {
    font-size: 24px;
    font-weight: 700;
    color: #0b3f89;
    margin: 0 0 16px 0;
}

.legal-card__content {
    color: #475569;
    font-size: 15px;
    line-height: 1.7;
}

.legal-card__content p {
    margin: 8px 0;
}

.legal-card__content strong {
    color: #1e293b;
    font-weight: 600;
}

.legal-section {
    background: white;
    border-radius: 16px;
    padding: 40px;
    margin-bottom: 32px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
}

.legal-section h2 {
    font-size: 32px;
    color: #0b3f89;
    margin: 0 0 24px 0;
    padding-bottom: 16px;
    border-bottom: 3px solid #e2e8f0;
    font-weight: 700;
}

.legal-section h3 {
    font-size: 20px;
    color: #1e293b;
    margin: 28px 0 16px 0;
    font-weight: 600;
}

.legal-section p {
    color: #475569;
    margin: 12px 0;
    line-height: 1.8;
}

.legal-section ul {
    margin: 16px 0;
    padding-left: 24px;
}

.legal-section li {
    color: #475569;
    margin: 8px 0;
    line-height: 1.7;
}

.info-badge {
    display: inline-block;
    background: linear-gradient(135deg, #0b3f89 0%, #1e5cb8 100%);
    color: white;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    margin-right: 8px;
    margin-bottom: 8px;
}

.highlight-box {
    background: #f0f9ff;
    border-left: 4px solid #0b3f89;
    padding: 24px;
    margin: 24px 0;
    border-radius: 8px;
}

.highlight-box strong {
    color: #0b3f89;
}

.contact-cta {
    background: linear-gradient(135deg, #0b3f89 0%, #1e5cb8 100%);
    color: white;
    padding: 48px 40px;
    border-radius: 20px;
			text-align: center;
    margin-top: 48px;
}

.contact-cta h2 {
    color: white;
    border: none;
    margin: 0 0 16px 0;
    font-size: 32px;
}

.contact-cta p {
    font-size: 18px;
    opacity: 0.95;
    margin: 16px 0;
}

.contact-cta a {
    color: white;
    font-weight: 600;
    text-decoration: underline;
    font-size: 20px;
}

.contact-cta a:hover {
    opacity: 0.9;
}

/* Responsive */
@media (max-width: 768px) {
    .legal-page {
        padding: 40px 16px;
    }
    
    .legal-header h1 {
        font-size: 36px;
    }
    
    .legal-grid {
        grid-template-columns: 1fr;
    }
    
    .legal-card,
    .legal-section {
        padding: 24px;
    }
		}
	</style>
{% endblock %}

