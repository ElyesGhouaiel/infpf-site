<!-- ===== STRIPE.JS SUPPRIMÉ - NON UTILISÉ SUR CETTE PAGE =====
     Les paiements passent par CPF externe ou demande de devis
     Économie : 205 KiB JS + 2100ms de blocage rendu
-->

<script>
// ===== TOC FLOTTANT SIMPLE (DESKTOP + MOBILE) ===== 
// MOBILE ONLY: Mirrored desktop logic - same behavior, adapted UI via CSS
console.log('🚀 SCRIPT TOC: Démarrage');
(function(){
    console.log('💻 SCRIPT TOC: Fonction anonyme exécutée (desktop + mobile)');

    // calcule la hauteur du header pour l'offset (ajuste selon ta classe)
    function headerOffset(){
        const header = document.querySelector('header, .site-header, nav[role="navigation"], .header');
        const h = header ? header.getBoundingClientRect().height : 80;
        return Math.max(72, Math.min(140, Math.round(h + 16))); // marge de confort
    }

    // met le TOC à la bonne largeur/position horizontale (à l'emplacement de la colonne gauche)
    function positionLeft(){
        const anchor = document.getElementById('toc-anchor');
        const toc = document.getElementById('toc');
        if (!anchor || !toc) return;
        
        const r = anchor.getBoundingClientRect();
        const sx = window.scrollX || window.pageXOffset || 0;
        // on cale le TOC exactement où se trouve l'ancre (même largeur)
        toc.style.setProperty('--toc-left', `${r.left + sx}px`);
        toc.style.setProperty('--toc-width', `${r.width || 260}px`);
        toc.style.setProperty('--toc-offset', `${headerOffset()}px`);
    }

    // active/désactive le mode "fixed" selon le scroll
    function onScroll(){
        const anchor = document.getElementById('toc-anchor');
        const toc = document.getElementById('toc');
        if (!anchor || !toc) return;
        
        // Détection footer pour disparition
        const footer = document.querySelector('footer, .footer, .site-footer');
        const footerTop = footer ? footer.getBoundingClientRect().top + window.scrollY : Infinity;
        const isNearFooter = window.scrollY >= footerTop - window.innerHeight;
        
        const start = anchor.getBoundingClientRect().top + window.scrollY;
        const heroHeight = document.querySelector('.hero--formation')?.offsetHeight || 0;
        // Apparaître dès qu'on commence à voir le contenu (200px avant la fin du hero)
        const shouldShow = window.scrollY >= (heroHeight - 200) && !isNearFooter;
        
        // Gestion apparition/disparition
        if(shouldShow && !toc.classList.contains('is-visible')) {
            toc.classList.add('is-visible');
            console.log('✨ TOC: Apparition');
        } else if(!shouldShow && toc.classList.contains('is-visible')) {
            toc.classList.remove('is-visible');
            console.log('👻 TOC: Disparition');
        }
        
        // Gestion mode fixed (seulement si visible)
        if(shouldShow && !toc.classList.contains('is-fixed')) {
            toc.classList.add('is-fixed');
            console.log('🔧 TOC: Mode FIXED activé');
        } else if(!shouldShow && toc.classList.contains('is-fixed')) {
            toc.classList.remove('is-fixed');
            console.log('🔧 TOC: Mode STATIC restauré');
        }
    }

    // Position à droite pour les détails
    function positionRight(){
        // Cibler SEULEMENT le bloc détails du côté (pas celui du hero)
        const details = document.querySelector('.layout-formation .details-card:not(.details-card--hero)');
        if (!details) return;
        
        // Calculer la position à droite de l'écran
        const rightOffset = 24; // marge depuis le bord droit
        details.style.setProperty('--details-right', `${rightOffset}px`);
        details.style.setProperty('--details-width', '320px');
        console.log('📍 Details position: right =', rightOffset + 'px');
    }

    // Gestion scroll pour les détails
    function onScrollDetails(){
        const anchor = document.getElementById('toc-anchor');
        // Cibler SEULEMENT le bloc détails du côté (pas celui du hero)
        const details = document.querySelector('.layout-formation .details-card:not(.details-card--hero)');
        if (!anchor || !details) return;
        
        // Détection footer pour disparition
        const footer = document.querySelector('footer, .footer, .site-footer');
        const footerTop = footer ? footer.getBoundingClientRect().top + window.scrollY : Infinity;
        const isNearFooter = window.scrollY >= footerTop - window.innerHeight;
        
        const start = anchor.getBoundingClientRect().top + window.scrollY;
        const heroHeight = document.querySelector('.hero--formation')?.offsetHeight || 0;
        // Apparaître dès qu'on commence à voir le contenu (200px avant la fin du hero)
        const shouldShow = window.scrollY >= (heroHeight - 200) && !isNearFooter;
        
        // Gestion apparition/disparition
        if(shouldShow && !details.classList.contains('is-visible')) {
            details.classList.add('is-visible');
            console.log('✨ Details: Apparition');
        } else if(!shouldShow && details.classList.contains('is-visible')) {
            details.classList.remove('is-visible');
            console.log('👻 Details: Disparition');
        }
        
        // Gestion mode fixed (seulement si visible)
        if(shouldShow && !details.classList.contains('is-fixed')) {
            details.classList.add('is-fixed');
            console.log('🔧 Details: Mode FIXED activé');
        } else if(!shouldShow && details.classList.contains('is-fixed')) {
            details.classList.remove('is-fixed');
            console.log('🔧 Details: Mode STATIC restauré');
        }
    }

    // scroll instantané pour permettre des clics rapides successifs
    function wireLinks(){
        document.querySelectorAll('#toc a[href^="#"]').forEach(a=>{
            a.addEventListener('click', (e)=>{
                const id = a.getAttribute('href');
                const target = document.querySelector(id);
                if(!target) return;
            e.preventDefault();
                const y = target.getBoundingClientRect().top + window.scrollY - headerOffset();
                window.scrollTo({ top: y, behavior: 'auto' });
            });
        });
    }

    // ===== SCROLL-SPY DYNAMIQUE POUR PROGRESSION UTILISATEUR =====
    function initScrollSpy(){
        console.log('🎯 Initialisation du scroll-spy dynamique');
        
        // Toutes les sections avec ancres *-start
        const sections = document.querySelectorAll('[id$="-start"]');
        const tocLinks = document.querySelectorAll('#toc a[href^="#"]');
        
        if(sections.length === 0 || tocLinks.length === 0) {
            console.log('❌ Sections ou liens TOC non trouvés');
            return;
        }

        // Créer une map href -> lien pour la performance
        const linkMap = new Map();
        tocLinks.forEach(link => {
            const href = link.getAttribute('href');
            if(href) linkMap.set(href, link);
        });

        // IntersectionObserver pour détecter la section visible
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    // Retirer is-active de tous les liens
                    tocLinks.forEach(link => link.classList.remove('is-active'));
                    
                    // Ajouter is-active au lien correspondant
                    const href = '#' + entry.target.id;
                    const activeLink = linkMap.get(href);
                    if(activeLink) {
                        activeLink.classList.add('is-active');
                        console.log('📍 Section active:', entry.target.id, '-> Lien mis en bleu');
                    }
                }
            });
        }, {
            // Zone de détection : 30% du viewport au centre
            rootMargin: '-35% 0px -35% 0px',
            threshold: 0.1
        });

        // Observer toutes les sections
        sections.forEach(section => observer.observe(section));
        
        console.log('✅ Scroll-spy actif sur', sections.length, 'sections');
    }

    // init + évènements
    function init(){
        console.log('🎯 TOC System: Initialisation');
        
        // Vérifier les éléments gérés
        const heroDetails = document.querySelector('.details-card--hero');
        const sideDetails = document.querySelector('.layout-formation .details-card:not(.details-card--hero)');
        console.log('🏠 Détails HERO (fixe):', !!heroDetails);
        console.log('📜 Détails CÔTÉ (floating):', !!sideDetails);
        
        positionLeft();
        positionRight();
        onScroll();
        onScrollDetails();
        wireLinks();
        initScrollSpy(); // Ajout du scroll-spy dynamique
        console.log('✅ TOC System: Prêt avec scroll-spy dynamique');
    }

    // ===== DÉSACTIVER SUR MOBILE - Conflit avec le toggle mobile =====
    if (window.innerWidth <= 1100) {
        console.log('📱 TOC Desktop désactivé sur mobile (largeur:', window.innerWidth, 'px)');
        return;
    }

    console.log('🔧 TOC: Ajout des event listeners');
    console.log('🔧 TOC: readyState =', document.readyState);
    
    // Debug: lister tous les éléments avec id
    console.log('🔧 TOC: Éléments avec ID:', Array.from(document.querySelectorAll('[id]')).map(el => el.id));
    
    // Attendre que le DOM soit prêt
    function waitForElements(attempt = 1) {
        console.log(`🔧 TOC: Tentative ${attempt} de recherche des éléments`);
        
        const toc = document.getElementById('toc');
        const anchor = document.getElementById('toc-anchor');
        const details = document.querySelector('.details-card');
        
        console.log('🔍 TOC trouvé:', !!toc, toc);
        console.log('🔍 Anchor trouvé:', !!anchor, anchor);
        console.log('🔍 Details trouvé:', !!details, details);
        
        if (toc && anchor) {
            console.log('✅ TOC et Anchor trouvés, initialisation...');
            init();
            window.addEventListener('scroll', () => {
                onScroll();
                onScrollDetails();
            }, {passive:true});
            window.addEventListener('resize', ()=>{ 
                positionLeft(); 
                positionRight();
                onScroll(); 
                onScrollDetails();
            });
            window.addEventListener('orientationchange', ()=>{ 
                positionLeft(); 
                positionRight();
                onScroll(); 
                onScrollDetails();
            });
        } else if (attempt < 50) { // max 5 secondes
            console.log(`⏳ Attente des éléments... (tentative ${attempt}/50)`);
            setTimeout(() => waitForElements(attempt + 1), 100);
            } else {
            console.error('❌ TOC: Timeout - éléments introuvables après 5 secondes');
        }
    }
    
    // Démarrer l'attente seulement après que le DOM soit prêt
    if (document.readyState === 'loading') {
        console.log('🔧 TOC: DOM en cours de chargement, attente DOMContentLoaded');
        document.addEventListener('DOMContentLoaded', () => {
            console.log('🔧 TOC: DOMContentLoaded déclenché');
            waitForElements();
        });
    } else {
        console.log('🔧 TOC: DOM déjà prêt, démarrage immédiat');
        waitForElements();
    }
})();

// ===== CALENDLY (GARDÉ) =====
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.btn-calendly-detail').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const url = this.getAttribute('data-calendly-url');
            
            if (typeof Calendly !== 'undefined') {
                Calendly.initPopupWidget({ url });
            } else {
                window.open(url, '_blank');
            }
        });
    });
});
</script>

<!-- MOBILE ONLY: Script pour toggle du sommaire mobile -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Actif uniquement sur mobile
    if (window.innerWidth > 1100) {
        console.log('📱 Toggle mobile désactivé sur desktop');
        return;
    }
    
    console.log('📱 Toggle mobile: Initialisation...');
    
    const toggleBtn = document.getElementById('toc-toggle-mobile');
    const toc = document.getElementById('toc');
    
    console.log('🔍 Bouton trouvé:', !!toggleBtn, toggleBtn);
    console.log('🔍 TOC trouvé:', !!toc, toc);
    
    if (!toggleBtn || !toc) {
        console.error('❌ Bouton ou TOC introuvable');
        return;
    }
    
    // État initial: TOC caché
    let isOpen = false;
    
    toggleBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        isOpen = !isOpen;
        
        console.log('🖱️ Clic sur bouton sommaire, isOpen =', isOpen);
        
        if (isOpen) {
            // Ouvrir: forcer l'affichage
            toc.classList.add('is-visible', 'is-fixed');
            toggleBtn.classList.add('active');
            toggleBtn.setAttribute('aria-expanded', 'true');
            
            // FORCER EN JAVASCRIPT (ultime recours) + ACTIVER LES CLICS
            toc.style.setProperty('display', 'block', 'important');
            toc.style.setProperty('height', 'auto', 'important');
            toc.style.setProperty('max-height', 'none', 'important');
            toc.style.setProperty('overflow', 'visible', 'important');
            toc.style.setProperty('pointer-events', 'auto', 'important');
            toc.style.setProperty('z-index', '1000', 'important');
            toc.style.setProperty('pointer-events', 'auto', 'important');
            
            // Ajuster le top selon la taille d'écran
            const btnRect = toggleBtn.getBoundingClientRect();
            const topPosition = btnRect.bottom; // Juste sous le bouton
            toc.style.setProperty('top', topPosition + 'px', 'important');
            
            const nav = toc.querySelector('nav');
            if (nav) {
                nav.style.setProperty('display', 'flex', 'important');
                nav.style.setProperty('flex-direction', 'column', 'important');
                nav.style.setProperty('height', 'auto', 'important');
                nav.style.setProperty('max-height', 'none', 'important');
                
                const links = nav.querySelectorAll('a');
                links.forEach(link => {
                    link.style.setProperty('display', 'block', 'important');
                    link.style.setProperty('height', 'auto', 'important');
                    link.style.setProperty('min-height', '50px', 'important');
                    link.style.setProperty('padding', '16px 20px', 'important');
                    link.style.setProperty('opacity', '1', 'important');
                    link.style.setProperty('visibility', 'visible', 'important');
                    link.style.setProperty('pointer-events', 'auto', 'important');
                    link.style.setProperty('cursor', 'pointer', 'important');
                    link.style.setProperty('z-index', '1001', 'important');
                    
                    // NAVIGATION: Smooth scroll vers la section
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        const targetId = this.getAttribute('href');
                        const targetElement = document.querySelector(targetId);
                        
                        if (targetElement) {
                            // Fermer le menu
                            isOpen = false;
                            toc.classList.remove('is-visible', 'is-fixed');
                            toggleBtn.classList.remove('active');
                            toggleBtn.setAttribute('aria-expanded', 'false');
                            
                            // Scroller vers la section
                            const headerOffset = 180; // Offset pour le header fixe
                            const elementPosition = targetElement.getBoundingClientRect().top;
                            const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                            
                            window.scrollTo({
                                top: offsetPosition,
                                behavior: 'smooth'
                            });
                            
                            console.log('📍 Navigation vers:', targetId);
                        }
                    });
                });
                
                console.log('✅ Styles + Navigation forcés sur', links.length, 'liens');
            }
            
            // LOGS DE DEBUG
            console.log('📖 Sommaire mobile ouvert');
            console.log('🔍 Classes TOC:', toc.classList.toString());
            console.log('🔍 Style display:', window.getComputedStyle(toc).display);
            console.log('🔍 Style opacity:', window.getComputedStyle(toc).opacity);
            console.log('🔍 Style visibility:', window.getComputedStyle(toc).visibility);
            console.log('🔍 Position TOC:', toc.getBoundingClientRect());
            
            // Forcer un reflow
            setTimeout(() => {
                console.log('🔍 Position TOC après 100ms:', toc.getBoundingClientRect());
            }, 100);
        } else {
            // Fermer: retirer les classes ET désactiver les clics
            toc.classList.remove('is-visible', 'is-fixed');
            toggleBtn.classList.remove('active');
            toggleBtn.setAttribute('aria-expanded', 'false');
            
            // DÉSACTIVER LES CLICS quand fermé
            toc.style.setProperty('pointer-events', 'none', 'important');
            toc.style.setProperty('display', 'none', 'important');
            toc.style.setProperty('height', '0', 'important');
            toc.style.setProperty('overflow', 'hidden', 'important');
            
            console.log('📕 Sommaire mobile fermé et désactivé');
        }
    });
    
    // Fermer le sommaire quand on clique sur un lien
    toc.querySelectorAll('nav a').forEach(link => {
        link.addEventListener('click', function() {
            isOpen = false;
            toc.classList.remove('is-visible', 'is-fixed');
            toggleBtn.classList.remove('active');
            toggleBtn.setAttribute('aria-expanded', 'false');
            
            // DÉSACTIVER LES CLICS quand fermé
            toc.style.setProperty('pointer-events', 'none', 'important');
            toc.style.setProperty('display', 'none', 'important');
            toc.style.setProperty('height', '0', 'important');
            
            console.log('🔗 Lien cliqué, sommaire fermé et désactivé');
        });
    });
    
    console.log('✅ Toggle mobile initialisé avec succès');
});
</script>

