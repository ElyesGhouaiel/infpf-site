/* ===== NAVIGATION AVEC SCROLL-MARGIN ===== */
[id$="-start"] {
    scroll-margin-top: var(--stickytop);
}

.floating-toc:hover {
    /* Effet hover liquid glass ultra moderne */
    background: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(35px) saturate(1.6);
    -webkit-backdrop-filter: blur(35px) saturate(1.6);
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 
        0 30px 80px rgba(0, 0, 0, 0.18),
        0 15px 40px rgba(0, 0, 0, 0.12),
        inset 0 3px 0 rgba(255, 255, 255, 0.7),
        inset 0 -3px 0 rgba(255, 255, 255, 0.4);
    transform: translateY(-50%) translateX(15px) scale(1.08);
}

.floating-toc-header {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--primary-color);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--primary-color);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

.floating-toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
}

.floating-toc-link {
    display: block;
    padding: var(--space-xl) var(--space-2xl);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 600;
    border-radius: 18px;
    transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
    overflow: hidden;
    
    /* Glass effect ultra moderne */
    background: rgba(255, 255, 255, 0.12);
    border: 2px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    box-shadow: 
        0 4px 15px rgba(0, 0, 0, 0.08),
        inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.floating-toc-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 6px;
    height: 100%;
    background: linear-gradient(180deg, var(--primary-color), var(--secondary-color));
    transform: scaleY(0);
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    border-radius: 0 6px 6px 0;
    box-shadow: 2px 0 8px rgba(11, 63, 137, 0.3);
}

.floating-toc-link::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    opacity: 0;
    transition: opacity 0.4s ease;
    border-radius: 16px;
}

.floating-toc-link:hover {
    color: var(--primary-color);
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(11, 63, 137, 0.5);
    text-decoration: none;
    transform: translateX(12px) scale(1.02);
    box-shadow: 
        0 8px 25px rgba(11, 63, 137, 0.2),
        inset 0 2px 0 rgba(255, 255, 255, 0.7),
        inset 0 -2px 0 rgba(255, 255, 255, 0.3);
}

.floating-toc-link:hover::after {
    opacity: 1;
}

.floating-toc-link.is-active {
    color: var(--text-white);
    background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
    border-color: var(--secondary-color);
    font-weight: 700;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
    transform: translateX(18px) scale(1.05);
    box-shadow: 
        0 15px 40px rgba(11, 63, 137, 0.3),
        inset 0 2px 0 rgba(255, 255, 255, 0.3),
        inset 0 -2px 0 rgba(0, 0, 0, 0.1);
}

.floating-toc-link.is-active::before {
    transform: scaleY(1);
    background: var(--secondary-color);
}

.floating-toc-link.is-active::after {
    opacity: 1;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.1));
}

