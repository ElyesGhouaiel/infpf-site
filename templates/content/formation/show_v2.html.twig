                <div class="fv2-sidebar__cta">
                    {% if formations.cpfUrl %}
                    <a href="{{ formations.cpfUrl }}" target="_blank" rel="noopener" class="fv2-btn fv2-btn--primary">Inscription avec le CPF</a>
                    <a href="{{ path('app_contact') }}#formulaire-contact" class="fv2-btn fv2-btn--secondary">Inscription hors CPF</a>
                    {% else %}
                    <a href="{{ path('app_contact') }}#formulaire-contact" class="fv2-btn fv2-btn--primary">Demander un devis</a>
                    {% endif %}
                </div>
                <div class="fv2-sidebar__links">
                    {% if formations.id != 90 %}
                    <a href="{{ path('download_document', {'id': formations.id}) }}" download>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Télécharger le programme
                    </a>
                    {% endif %}
                    <a href="{{ path('app_contact') }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        Nous contacter
                    </a>
                </div>

                <div class="fv2-sidebar__trust">
                    <span class="fv2-trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Certification Qualiopi</span>
                    {% if formations.cpfUrl %}<span class="fv2-trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Éligible CPF</span>{% endif %}
                    <span class="fv2-trust-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Accompagnement personnalisé</span>
