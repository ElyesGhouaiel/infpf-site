                {% if formations.cpfUrl %}
                <a href="{{ formations.cpfUrl }}" target="_blank" rel="noopener" class="fv2-btn fv2-btn--white">Inscription avec le CPF</a>
                <a href="{{ path('app_contact') }}#formulaire-contact" class="fv2-btn fv2-btn--outline">Inscription hors CPF</a>
                {% else %}
                <a href="{{ path('app_contact') }}#formulaire-contact" class="fv2-btn fv2-btn--white">Demander un devis</a>
