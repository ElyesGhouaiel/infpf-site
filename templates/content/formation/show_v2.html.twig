    </div>{# /fv2-body #}

    {# ===========================
       STICKY MOBILE BAR
       =========================== #}
    {% if formations.priceFormation %}
    <div class="fv2-sticky" id="fv2Sticky" aria-label="Prix et inscription">
        <div class="fv2-sticky__price">
            {{ formations.priceFormation|number_format(0, ',', ' ') }} €
            <small>Net de taxes</small>
        </div>
        {% if formations.cpfUrl %}
        <a href="{{ formations.cpfUrl }}" target="_blank" rel="noopener" class="fv2-btn fv2-btn--primary">Inscription avec le CPF</a>
        {% else %}
        <a href="{{ path('app_contact') }}#formulaire-contact" class="fv2-btn fv2-btn--primary">Demander un devis</a>
        {% endif %}
    </div>
    {% endif %}

</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    'use strict';

    var hero = document.querySelector('.fv2-hero');
    var sticky = document.getElementById('fv2Sticky');
    var progress = document.getElementById('fv2Progress');
    var progBody = document.getElementById('fv2ProgBody');
    var progToggle = document.getElementById('fv2ProgToggle');

    function onScroll() {
        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        var docHeight = document.documentElement.scrollHeight - window.innerHeight;

        if (progress && docHeight > 0) {
            progress.style.width = Math.min((scrollTop / docHeight) * 100, 100) + '%';
        }

        if (sticky && hero) {
            var heroBottom = hero.getBoundingClientRect().bottom;
            sticky.classList.toggle('is-visible', heroBottom < 0);
        }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    if (progBody && progToggle) {
        if (progBody.scrollHeight <= 480) {
            progBody.classList.add('is-short', 'is-open');
            progToggle.style.display = 'none';
        }

        var progSection = progBody.closest('.fv2-section') || progBody.closest('.fv2-prog');
        progToggle.addEventListener('click', function() {
            var open = progBody.classList.toggle('is-open');
            this.classList.toggle('is-open', open);
            this.querySelector('span').textContent = open ? 'Réduire le programme' : 'Voir le programme complet';
            this.setAttribute('aria-expanded', open);
            if (!open && progSection) {
                progSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    }

    document.querySelectorAll('[data-expandable]').forEach(function(body) {
        var btn = body.parentElement.querySelector('[data-expand-btn]');
        if (!btn) return;
        if (body.scrollHeight <= 240) {
            body.classList.add('is-short');
            btn.style.display = 'none';
            return;
        }
        var card = body.closest('.fv2-card');
        btn.addEventListener('click', function() {
            var open = body.classList.toggle('is-open');
            this.classList.toggle('is-open', open);
            this.querySelector('span').textContent = open ? 'Réduire' : 'Lire la suite';
            this.setAttribute('aria-expanded', open);
            if (!open && card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    });

    document.querySelectorAll('a[href^="#"]').forEach(function(link) {
        link.addEventListener('click', function(e) {
            var targetId = this.getAttribute('href').substring(1);
            var target = document.getElementById(targetId);
            if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    });

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var fv2Root = document.querySelector('.fv2');
    if (!prefersReducedMotion && fv2Root && 'IntersectionObserver' in window) {
        var fadeEls = document.querySelectorAll('.fv2-fade');
        if (fadeEls.length) {
            fv2Root.classList.add('fv2-animated');
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.05, rootMargin: '0px 0px -20px 0px' });
            fadeEls.forEach(function(el) { observer.observe(el); });
        }
    }
});
</script>
{% endblock %}
