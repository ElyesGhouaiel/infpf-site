{% extends 'base.html.twig' %}

{% block title %}Protection des données - INFPF{% endblock %}

{% block body %}
<div class="rgpd-page" style="max-width: 800px; margin: 120px auto 60px; padding: 0 20px;">
    <h1 style="color: #0b3f89; margin-bottom: 30px;">Protection de vos données personnelles</h1>
    
    <div style="background: #f8f9fa; border-radius: 12px; padding: 30px; margin-bottom: 30px;">
        <p style="font-size: 1.1rem; line-height: 1.8; color: #333;">
            Conformément au Règlement Général sur la Protection des Données (RGPD), nous vous informons de la manière dont vos données sont collectées et utilisées sur ce site.
        </p>
    </div>

    <div style="display: grid; gap: 20px;">
        
        <!-- Cookies -->
        <div style="background: white; border: 1px solid #e0e0e0; border-radius: 12px; padding: 25px;">
            <h3 style="color: #0b3f89; margin-bottom: 15px;">Cookies et traceurs</h3>
            <p style="color: #555; line-height: 1.7; margin-bottom: 15px;">
                Notre site utilise des cookies pour améliorer votre expérience de navigation et analyser le trafic. 
                Vous pouvez à tout moment modifier vos préférences concernant les cookies.
            </p>
            <button class="ot-sdk-show-settings" style="background: #0b3f89; color: white; padding: 12px 24px; border-radius: 8px; border: none; cursor: pointer; font-size: 1rem;">
                Gérer mes cookies
            </button>
        </div>

        <!-- Formulaire de contact -->
        <div style="background: white; border: 1px solid #e0e0e0; border-radius: 12px; padding: 25px;">
            <h3 style="color: #0b3f89; margin-bottom: 15px;">Formulaire de contact</h3>
            <p style="color: #555; line-height: 1.7;">
                Lorsque vous nous contactez via le formulaire, nous collectons votre nom, email et numéro de téléphone 
                afin de traiter votre demande. Ces données sont conservées le temps nécessaire au traitement de votre demande 
                et ne sont jamais transmises à des tiers.
            </p>
        </div>

        <!-- Vos droits -->
        <div style="background: white; border: 1px solid #e0e0e0; border-radius: 12px; padding: 25px;">
            <h3 style="color: #0b3f89; margin-bottom: 15px;">Vos droits</h3>
            <p style="color: #555; line-height: 1.7;">
                Conformément au RGPD, vous disposez d'un droit d'accès, de rectification et de suppression 
                de vos données personnelles. Pour exercer ces droits, contactez-nous à 
                <a href="mailto:contact@infpf.fr" style="color: #0b3f89;">contact@infpf.fr</a>.
            </p>
        </div>

    </div>

    <div style="margin-top: 40px; padding: 20px; background: #e8f4fd; border-radius: 12px;">
        <p style="color: #0b3f89; margin: 0;">
            <strong>Contact :</strong> Pour toute question relative à vos données personnelles, 
            contactez-nous à <a href="mailto:contact@infpf.fr" style="color: #0b3f89;">contact@infpf.fr</a>
        </p>
    </div>
</div>
{% endblock %}
